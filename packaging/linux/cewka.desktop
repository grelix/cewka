[Desktop Entry]
Type=Application
Name=Cewka
GenericName=Music Player
GenericName[pl]=Odtwarzacz muzyki
Comment=Play music files from disk with an equaliser and loudness levelling
Comment[pl]=Odtwarzanie plików muzycznych z dysku, z korektorem i wyrównaniem głośności
Exec=cewka %F
Icon=cewka
Terminal=false
Categories=AudioVideo;Audio;Player;
Keywords=music;audio;player;
Keywords[pl]=muzyka;dźwięk;odtwarzacz;
StartupNotify=true
StartupWMClass=Cewka
MimeType=audio/mpeg;audio/flac;audio/x-flac;audio/wav;audio/x-wav;audio/ogg;audio/x-vorbis+ogg;audio/opus;audio/x-opus+ogg;audio/mp4;audio/aac;audio/x-m4a;
