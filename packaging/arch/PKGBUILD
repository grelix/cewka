# Maintainer: Maciej Grela <51171746+grelix@users.noreply.github.com>
#
# Pakiet pacmana z wydania powstaje na Ubuntu bez makepkg i nie ma pliku .MTREE.
# Na Archu lepiej zbudować go z tego pliku.

pkgname=cewka
pkgver=1.0.0
pkgrel=1
pkgdesc="Odtwarzacz plików muzycznych z korektorem i wyrównaniem głośności"
arch=('x86_64')
url="https://github.com/grelix/cewka"
license=('MIT')
depends=('glibc' 'gcc-libs' 'zlib' 'libx11' 'libxrandr' 'libxi' 'fontconfig')
optdepends=('gst-plugins-base: potok dekodowania AAC, M4A i ALAC'
            'gst-plugins-good: rozpakowanie kontenera M4A'
            'gst-libav: dekoder AAC i ALAC'
            'openssl: radio i sprawdzanie nowszej wersji przez HTTPS')
makedepends=('dotnet-sdk>=10.0' 'gcc')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Suma kontrolna pominięta: archiwum składa GitHub przy pobraniu.
sha256sums=('SKIP')
# Plik jednoplikowy .NET to apphost z pakunkiem doklejonym za sekcjami ELF. Strip składa plik
# od nowa z samych sekcji i pakunek przepada, więc program przestaje startować (tak samo
# wyłącza go spec RPM w tools/build-packages.sh). Symboli i tak nie ma: DebugType=none.
options=('!strip' '!debug')

build() {
    cd "$srcdir/$pkgname-$pkgver"

    # Biblioteka natywna musi powstać przed publikacją — jest pakowana do wyniku.
    ./native/build-linux.sh

    dotnet publish src/Cewka.App \
        --configuration Release \
        --runtime linux-x64 \
        -p:PublishSingleFile=true \
        --output publish
}

package() {
    cd "$srcdir/$pkgname-$pkgver"

    install -Dm755 publish/Cewka "$pkgdir/usr/bin/cewka"
    install -Dm644 packaging/linux/cewka.desktop "$pkgdir/usr/share/applications/cewka.desktop"

    local rozmiar
    for rozmiar in 16 22 24 32 48 64 128 256; do
        install -Dm644 "packaging/linux/icons/cewka-$rozmiar.png" \
            "$pkgdir/usr/share/icons/hicolor/${rozmiar}x${rozmiar}/apps/cewka.png"
    done
    install -Dm644 assets/ikona/cewka.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/cewka.svg"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 THIRD-PARTY-NOTICES.txt "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES.txt"
}
