<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Cewka.Audio</RootNamespace>
    <AssemblyName>Cewka.Audio</AssemblyName>
    <!-- Potrzebne dla wskaznikow w torze DSP i dla callbackow wolanych z watku natywnego. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="Concentus.OggFile" Version="1.0.7" />
    <PackageReference Include="z440.atl.core" Version="7.16.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cewka.Platform\Cewka.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cewka.Audio.Tests" />
  </ItemGroup>

  <!--
    Biblioteka natywna budowana skryptami z katalogu native/, w ukladzie runtimes/{rid}/native,
    w ktorym szuka jej NativeAudio. Projekt nie zna platformy docelowej (przy publikacji SDK
    usuwa RuntimeIdentifier z referencji do biblioteki), wiec kopiuje wszystkie warianty;
    wariant obcej platformy odrzuca dopiero publikacja w Cewka.App.csproj.
  -->
  <ItemGroup>
    <None Include="runtimes\**\*" Condition="Exists('runtimes')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>runtimes\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
