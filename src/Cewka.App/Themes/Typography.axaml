<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Font osadzony w pliku wykonywalnym, żeby interfejs wyglądał tak samo
    w każdym systemie: Cantarell (SIL OFL 1.1).
  -->

  <FontFamily x:Key="UiFont">avares://Cewka/Assets/Fonts#Cantarell</FontFamily>

  <!-- Skala typograficzna odwzorowana z projektu -->
  <x:Double x:Key="FontSizeTitle">42</x:Double>
  <x:Double x:Key="FontSizeTitleCompact">32</x:Double>
  <x:Double x:Key="FontSizeArtist">17</x:Double>
  <x:Double x:Key="FontSizeSection">13.5</x:Double>
  <x:Double x:Key="FontSizeHeader">13</x:Double>
  <x:Double x:Key="FontSizeRow">12.5</x:Double>
  <x:Double x:Key="FontSizeSmall">10.5</x:Double>

</ResourceDictionary>
