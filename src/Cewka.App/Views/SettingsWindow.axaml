<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Cewka.App.Controls"
        xmlns:l="using:Cewka.App.Localisation"
        xmlns:vm="using:Cewka.App.ViewModels"
        x:Class="Cewka.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{l:Translate SettingsWindowTitle}"
        Icon="avares://Cewka/Assets/cewka.png"
        Width="820" Height="640"
        MinWidth="700" MinHeight="520"
        CanMaximize="False"
        WindowStartupLocation="Manual"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True">

  <Border x:Name="Shell" Classes="shell">

    <DockPanel>

      <!-- Pasek tytułu -->
      <Border x:Name="TitleBar"
              DockPanel.Dock="Top"
              Height="47"
              Background="{DynamicResource HeaderBarBrush}"
              BorderBrush="{DynamicResource StrokeBrush}"
              BorderThickness="0,0,0,1">
        <Panel>
          <TextBlock Text="{l:Translate Settings}" FontSize="13" FontWeight="Bold"
                     LetterSpacing="0.13"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />

          <!-- Przyciski po obu stronach, widoczny ten zgodny z ustawieniem; obsługa w kodzie. -->
          <DockPanel Margin="12,0,12,0">
            <c:WindowButtons x:Name="ControlsLeft" DockPanel.Dock="Left"
                             CloseOnly="True" IsVisible="False" VerticalAlignment="Center" />
            <c:WindowButtons x:Name="ControlsRight" DockPanel.Dock="Right"
                             CloseOnly="True" VerticalAlignment="Center" />
            <Panel />
          </DockPanel>
        </Panel>
      </Border>

      <Grid ColumnDefinitions="188,*">

        <!-- Zakładki: lista pionowa, żeby nazwy sekcji mieściły się w całości w każdym języku -->
        <Border Grid.Column="0"
                Background="{DynamicResource HeaderBarBrush}"
                BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="0,0,1,0">
          <ItemsControl ItemsSource="{Binding Sections}" Margin="10,16,10,16">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="3" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SettingsSection">
                <c:OptionButton Classes="option wide" Classes.on="{Binding IsSelected}" IsSelected="{Binding IsSelected}"
                                AutomationProperties.Name="{Binding Label}"
                        Click="OnSectionClick"
                        Height="32"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                  <TextBlock Text="{Binding Label}" FontSize="12"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{Binding $parent[Button].Foreground}" />
                </c:OptionButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <!-- Treść; pasek przewijania jak w kolejce, zamiast domyślnego z motywu Fluent -->
        <Panel Grid.Column="1">
          <ScrollViewer x:Name="ContentArea"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Hidden">
            <Panel Margin="24,20,30,26">

              <!-- ========== Wygląd ========== -->
              <StackPanel Spacing="18" IsVisible="{Binding Appearance.IsSelected}">
                <!-- Bez tytułu karty: nazwę sekcji podaje zakładka po lewej, na tej samej
                     wysokości -->
                <Border Classes="section">
                  <StackPanel Spacing="16">
                    <StackPanel Spacing="8">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingTheme}" />
                      <c:SegmentBar Group="{Binding Theme}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingWindowControls}" />
                      <c:SegmentBar Group="{Binding WindowControls}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingEffects}" />
                      <c:SegmentBar Group="{Binding Effects}" />
                      <TextBlock Classes="setting-hint" Text="{l:Translate HintEffects}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingColours}" />
                      <c:SegmentBar Group="{Binding Colours}" />
                      <TextBlock Classes="setting-hint" Text="{l:Translate HintColours}" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,16,0">
                        <TextBlock Classes="setting-label" Text="{l:Translate SettingFormatBadge}" />
                        <TextBlock Classes="setting-hint" Text="{l:Translate HintFormatBadge}" />
                      </StackPanel>
                      <c:GlassSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding ShowFormatBadge, Mode=TwoWay}"
                                     AutomationProperties.Name="{l:Translate SettingFormatBadge}"
                                     OffBrush="{DynamicResource TrackBrush}"
                                     OnBrush="{DynamicResource AccentBrush}"
                                     BorderBrush="{DynamicResource StrokeBrush}" />
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- Barwa domyślnej okładki: każda pozycja pokazuje przejście barw takie,
                     jakie wyjdzie w bieżącym motywie -->
                <Border Classes="section">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="section-title" Text="{l:Translate SettingPlaceholder}" />
                    <TextBlock Classes="setting-hint" Text="{l:Translate HintPlaceholder}" />
                    <ItemsControl ItemsSource="{Binding Palettes}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PaletteOption">
                          <c:OptionButton Classes="option wide" Classes.on="{Binding IsSelected}" IsSelected="{Binding IsSelected}"
                                AutomationProperties.Name="{Binding Label}"
                                  Click="OnPaletteClick"
                                  Width="168" Height="34" Margin="0,0,8,6"
                                  HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                              <Border Width="34" Height="12" CornerRadius="6"
                                      VerticalAlignment="Center"
                                      Background="{Binding Preview}" />
                              <TextBlock Text="{Binding Label}" FontSize="11.5"
                                         TextTrimming="CharacterEllipsis"
                                         Foreground="{Binding $parent[Button].Foreground}" />
                            </StackPanel>
                          </c:OptionButton>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

              </StackPanel>

              <!-- ========== Język ========== -->
              <StackPanel Spacing="18" IsVisible="{Binding LanguageSection.IsSelected}">

                <!-- Lista, bo przy kilkunastu pozycjach pasek segmentów nie mieści się w wierszu.
                     Kafel ma 168 px, żeby przy domyślnej szerokości okna w wierszu stały trzy
                     pozycje; w oknie ściśniętym do minimum WrapPanel zwija je do dwóch. -->
                <Border Classes="section">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="section-title" Text="{l:Translate SettingLanguage}" />
                    <ItemsControl ItemsSource="{Binding Language.Options}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SegmentOption">
                          <c:OptionButton Classes="option wide" Classes.on="{Binding IsSelected}" IsSelected="{Binding IsSelected}"
                                AutomationProperties.Name="{Binding Label}"
                                  Click="OnLanguageClick"
                                  Width="168" Height="30" Margin="0,0,8,6"
                                  HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                              <Ellipse Width="7" Height="7" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding Label}" FontSize="11.5"
                                         TextTrimming="CharacterEllipsis"
                                         Foreground="{Binding $parent[Button].Foreground}" />
                            </StackPanel>
                          </c:OptionButton>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <!--
                  Skąd pochodzą tłumaczenia, przy wyborze języka, z odsyłaczem do zgłoszeń
                  poprawek na końcu.
                -->
                <Border Classes="section" IsVisible="{Binding ShowTranslationNote}">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="setting-hint" Text="{l:Translate HintMachineTranslation}" />
                    <Button Classes="link" Click="OnOpenIssues"
                            IsVisible="{Binding HasRepository}"
                            Content="{l:Translate LanguageReportLink}" />
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- ========== Dźwięk ========== -->
              <StackPanel Spacing="18" IsVisible="{Binding Audio.IsSelected}">

                <Border Classes="section">
                  <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Classes="section-title"
                                 Text="{l:Translate SettingOutputDevice}" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="pill" Click="OnRefreshDevices"
                              Content="{l:Translate DeviceRefresh}" />
                    </Grid>

                    <!-- Lista zamiast listy rozwijanej, bo urządzeń jest zwykle kilka. -->
                    <StackPanel Spacing="8">
                      <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Spacing="2" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:DeviceOption">
                            <c:OptionButton Classes="option wide" Classes.on="{Binding IsSelected}" IsSelected="{Binding IsSelected}"
                                AutomationProperties.Name="{Binding Label}"
                                    Click="OnDeviceClick"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                              <StackPanel Orientation="Horizontal" Spacing="9">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" FontSize="11.5"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{Binding $parent[Button].Foreground}" />
                              </StackPanel>
                            </c:OptionButton>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Classes="setting-hint" Text="{Binding ActiveDeviceName}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingLatency}" />
                      <c:SegmentBar Group="{Binding Latency}" />
                      <TextBlock Classes="setting-hint" Text="{l:Translate HintLatency}" />
                      <TextBlock Classes="faint" FontSize="10.5" Text="{Binding LatencyDescription}" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border Classes="section">
                  <StackPanel Spacing="16">
                    <TextBlock Classes="section-title" Text="{l:Translate SectionProcessing}" />

                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                        <TextBlock Classes="setting-label" Text="{l:Translate OptionNormalisation}" />
                        <TextBlock Classes="setting-hint" Text="{l:Translate HintNormalisation}" />
                      </StackPanel>
                      <c:GlassSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding NormalisationEnabled, Mode=TwoWay}"
                                     AutomationProperties.Name="{l:Translate OptionNormalisation}"
                                     OffBrush="{DynamicResource TrackBrush}"
                                     OnBrush="{DynamicResource AccentBrush}"
                                     BorderBrush="{DynamicResource StrokeBrush}" />
                    </Grid>

                    <StackPanel Classes="setting" Spacing="8" IsEnabled="{Binding NormalisationEnabled}">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingLoudnessTarget}" />
                      <c:SegmentBar Group="{Binding Loudness}" />
                      <TextBlock Classes="setting-hint" Text="{l:Translate HintLoudnessTarget}" />
                    </StackPanel>

                    <Grid Classes="setting" ColumnDefinitions="*,Auto" IsEnabled="{Binding NormalisationEnabled}">
                      <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                        <TextBlock Classes="setting-label" Text="{l:Translate OptionAlwaysAnalyse}" />
                        <TextBlock Classes="setting-hint" Text="{l:Translate HintAlwaysAnalyse}" />
                      </StackPanel>
                      <c:GlassSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding AlwaysAnalyse, Mode=TwoWay}"
                                     AutomationProperties.Name="{l:Translate OptionAlwaysAnalyse}"
                                     OffBrush="{DynamicResource TrackBrush}"
                                     OnBrush="{DynamicResource AccentBrush}"
                                     BorderBrush="{DynamicResource StrokeBrush}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                        <TextBlock Classes="setting-label" Text="{l:Translate OptionLimiter}" />
                        <TextBlock Classes="setting-hint" Text="{l:Translate HintLimiter}" />
                      </StackPanel>
                      <c:GlassSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding LimiterEnabled, Mode=TwoWay}"
                                     AutomationProperties.Name="{l:Translate OptionLimiter}"
                                     OffBrush="{DynamicResource TrackBrush}"
                                     OnBrush="{DynamicResource AccentBrush}"
                                     BorderBrush="{DynamicResource StrokeBrush}" />
                    </Grid>

                    <StackPanel Spacing="8">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingQuality}" />
                      <c:SegmentBar Group="{Binding Quality}" />
                      <TextBlock Classes="setting-hint" Text="{l:Translate HintQuality}" />
                    </StackPanel>

                    <!-- Korektor i efekty mają jedno miejsce: pas w oknie głównym. -->
                    <TextBlock Classes="setting-hint" Text="{l:Translate HintEqualiserInMainWindow}" />
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- ========== Odtwarzanie ========== -->
              <StackPanel Spacing="18" IsVisible="{Binding Playback.IsSelected}">
                <Border Classes="section">
                  <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                        <TextBlock Classes="setting-label" Text="{l:Translate SettingRestoreSession}" />
                        <TextBlock Classes="setting-hint" Text="{l:Translate HintRestoreSession}" />
                      </StackPanel>
                      <c:GlassSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding RestoreSessionEnabled, Mode=TwoWay}"
                                     AutomationProperties.Name="{l:Translate SettingRestoreSession}"
                                     OffBrush="{DynamicResource TrackBrush}"
                                     OnBrush="{DynamicResource AccentBrush}"
                                     BorderBrush="{DynamicResource StrokeBrush}" />
                    </Grid>

                    <StackPanel Spacing="8">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingSeekStep}" />
                      <c:SegmentBar Group="{Binding SeekStep}" />
                      <TextBlock Classes="setting-hint" Text="{l:Translate HintSeekStep}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingFileOpen}" />
                      <c:SegmentBar Group="{Binding FileOpen}" />
                      <TextBlock Classes="setting-hint" Text="{l:Translate HintFileOpen}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- ========== System ========== -->
              <StackPanel Spacing="18" IsVisible="{Binding Integration.IsSelected}">
                <Border Classes="section">
                  <StackPanel Spacing="16">
                    <Grid Classes="setting" ColumnDefinitions="*,Auto" IsEnabled="{Binding MediaKeysSupported}">
                      <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                        <TextBlock Classes="setting-label" Text="{l:Translate SettingMediaKeys}" />
                        <TextBlock Classes="setting-hint" Text="{l:Translate HintMediaKeys}" />
                      </StackPanel>
                      <c:GlassSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding MediaKeysEnabled, Mode=TwoWay}"
                                     AutomationProperties.Name="{l:Translate SettingMediaKeys}"
                                     OffBrush="{DynamicResource TrackBrush}"
                                     OnBrush="{DynamicResource AccentBrush}"
                                     BorderBrush="{DynamicResource StrokeBrush}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                        <TextBlock Classes="setting-label" Text="{l:Translate SettingSingleInstance}" />
                        <TextBlock Classes="setting-hint" Text="{l:Translate HintSingleInstance}" />
                      </StackPanel>
                      <c:GlassSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding SingleInstanceEnabled, Mode=TwoWay}"
                                     AutomationProperties.Name="{l:Translate SettingSingleInstance}"
                                     OffBrush="{DynamicResource TrackBrush}"
                                     OnBrush="{DynamicResource AccentBrush}"
                                     BorderBrush="{DynamicResource StrokeBrush}" />
                    </Grid>

                    <StackPanel Spacing="3">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingMediaPanel}" />
                      <TextBlock Classes="setting-hint" Text="{Binding MediaPanelText}" />
                    </StackPanel>

                    <StackPanel Spacing="9" IsVisible="{Binding AssociationsSupported}">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingAssociations}" />
                      <TextBlock Classes="setting-hint" Text="{Binding AssociationStatus}" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="pill" Height="26" Padding="14,0"
                                Click="OnRegisterAssociations"
                                IsEnabled="{Binding CanRegisterAssociations}"
                                Content="{l:Translate AssociationsRegister}" />
                        <Button Classes="pill" Height="26" Padding="14,0"
                                Click="OnRemoveAssociations"
                                IsEnabled="{Binding CanRemoveAssociations}"
                                Content="{l:Translate AssociationsRemove}" />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- ========== Informacje ========== -->
              <StackPanel Spacing="18" IsVisible="{Binding About.IsSelected}">
                <Border Classes="section">
                  <StackPanel Spacing="13">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="tabular dim" Text="{Binding VersionText}" FontSize="11" />
                      <TextBlock Classes="tabular faint" Text="{Binding AudioEngineText}" FontSize="10.5" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                      <TextBlock Classes="setting-label" Text="{l:Translate AboutAuthor}" />
                      <TextBlock Classes="setting-hint" Text="{Binding AuthorText}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                      <TextBlock Classes="setting-label" Text="{l:Translate AboutDecoders}" />
                      <TextBlock Classes="setting-hint" Text="{Binding DecodersText}" />
                      <TextBlock Classes="setting-hint" Text="{Binding SystemCodecsText}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                      <TextBlock Classes="setting-label" Text="{l:Translate AboutLicences}" />
                      <TextBlock Classes="setting-hint" Text="{Binding LicenceText}" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- Skróty klawiszowe okna głównego. -->
                <Border Classes="section">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="setting-label" Text="{l:Translate AboutShortcuts}" />
                    <ItemsControl x:Name="ShortcutList" ItemsSource="{Binding Shortcuts}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="5" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ShortcutRow">
                          <Grid ColumnDefinitions="150,*" ColumnSpacing="12">
                            <TextBlock Grid.Column="0" Classes="dim" Text="{Binding Keys}" FontSize="11.5"
                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Classes="setting-hint" Text="{Binding Action}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <!--
                  Karta druga: sprawdzanie nowszego wydania, osobno, bo wymaga decyzji.
                  Przycisk działa na żądanie, a przełącznik włącza sprawdzanie przy uruchomieniu.
                -->
                <Border Classes="section" IsVisible="{Binding CanCheckForUpdates}">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="setting-label" Text="{l:Translate AboutUpdates}" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <Button Classes="pill" Height="26" Padding="14,0"
                              Click="OnCheckForUpdates"
                              IsEnabled="{Binding NotChecking}"
                              Content="{l:Translate UpdateCheckNow}" />
                      <TextBlock Classes="setting-hint" VerticalAlignment="Center"
                                 IsVisible="{Binding HasUpdateStatus}"
                                 Text="{Binding UpdateStatus}" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                        <TextBlock Classes="setting-label" Text="{l:Translate SettingUpdateCheck}" />
                        <TextBlock Classes="setting-hint" Text="{l:Translate HintUpdateCheck}" />
                      </StackPanel>
                      <c:GlassSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding CheckForUpdatesEnabled, Mode=TwoWay}"
                                     AutomationProperties.Name="{l:Translate SettingUpdateCheck}"
                                     OffBrush="{DynamicResource TrackBrush}"
                                     OnBrush="{DynamicResource AccentBrush}"
                                     BorderBrush="{DynamicResource StrokeBrush}" />
                    </Grid>
                  </StackPanel>
                </Border>

                <!--
                  Karta ostatnia: repozytorium. Odsyłacze poza program na końcu zakładki.
                -->
                <Border Classes="section" IsVisible="{Binding HasRepository}">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="setting-label" Text="{l:Translate AboutRepository}" />
                    <StackPanel Orientation="Horizontal" Spacing="14">
                      <Button Classes="link" Click="OnOpenRepository"
                              Content="{Binding RepositoryLabel}" />
                      <Button Classes="link" Click="OnOpenReleases"
                              Content="{l:Translate AboutReleases}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>

            </Panel>
          </ScrollViewer>

          <c:ThinScrollBar x:Name="ContentScrollBar"
                           HorizontalAlignment="Right" Margin="0,8,7,8"
                           TrackBrush="{DynamicResource TrackBrush}"
                           ThumbBrush="{DynamicResource Text3Brush}" />
        </Panel>
      </Grid>

    </DockPanel>
  </Border>

</Window>
