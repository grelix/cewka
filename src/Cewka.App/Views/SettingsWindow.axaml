<v:AuxiliaryWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Cewka.App.Controls"
        xmlns:l="using:Cewka.App.Localisation"
        xmlns:vm="using:Cewka.App.ViewModels"
        xmlns:v="using:Cewka.App.Views"
        x:Class="Cewka.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{l:Translate SettingsWindowTitle}"
        Width="832" Height="640"
        MinWidth="712" MinHeight="520"
        CanMaximize="False"
        WindowStartupLocation="Manual"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True">

  <Border x:Name="Shell" Classes="shell">

    <DockPanel>

      <!-- Pasek tytułu -->
      <Border x:Name="TitleBar"
              DockPanel.Dock="Top"
              Height="47"
              Background="{DynamicResource HeaderBarBrush}"
              BorderBrush="{DynamicResource StrokeBrush}"
              BorderThickness="0,0,0,1">
        <Panel>
          <TextBlock Text="{l:Translate Settings}" FontSize="13" FontWeight="Bold"
                     LetterSpacing="0.13"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />

          <!-- Przyciski po obu stronach, widoczny ten zgodny z ustawieniem; obsługa w kodzie. -->
          <DockPanel Margin="12,0,12,0">
            <c:WindowButtons x:Name="ControlsLeft" DockPanel.Dock="Left"
                             CloseOnly="True" IsVisible="False" VerticalAlignment="Center" />
            <c:WindowButtons x:Name="ControlsRight" DockPanel.Dock="Right"
                             CloseOnly="True" VerticalAlignment="Center" />
            <Panel />
          </DockPanel>
        </Panel>
      </Border>

      <Grid ColumnDefinitions="200,*">

        <!--
          Pasek boczny: kategorie główne jako nagłówki, pod nimi podkategorie. Lista pionowa, żeby nazwy
          mieściły się w całości w każdym języku; przewijana, gdy okno jest niskie.
        -->
        <Border Grid.Column="0"
                Background="{DynamicResource HeaderBarBrush}"
                BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="0,0,1,0">
          <DockPanel>
          <!-- Wyszukiwanie jak w ustawieniach macOS i Windows; Ctrl+F przenosi tu fokus, Esc czyści pole. -->
          <TextBox x:Name="SettingsSearchBox" DockPanel.Dock="Top" Margin="10,12,10,2"
                   Text="{Binding Search.Text, Mode=TwoWay}"
                   PlaceholderText="{l:Translate SettingsSearchPlaceholder}"
                   AutomationProperties.Name="{l:Translate SettingsSearchPlaceholder}"
                   MinHeight="30" CornerRadius="9" FontSize="12"
                   Background="{DynamicResource Glass2Brush}"
                   BorderBrush="{DynamicResource StrokeBrush}" />

          <Panel>
          <!-- Wyniki zamiast kategorii, dopóki pole nie jest puste. -->
          <ScrollViewer x:Name="SearchScroll" HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto" IsVisible="{Binding Search.IsActive}">
            <StackPanel Margin="10,10,10,16" Spacing="2">
              <TextBlock x:Name="SearchEmpty" Classes="setting-hint" Margin="10,6,0,0"
                         Text="{l:Translate SettingsSearchEmpty}" IsVisible="{Binding Search.HasNoResults}" />
              <ItemsControl x:Name="SearchResults" ItemsSource="{Binding Search.Results}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SettingsSearchResult">
                    <c:OptionButton Classes="option wide" Click="OnSearchResultClick"
                                    AutomationProperties.Name="{Binding Label}"
                                    AutomationProperties.HelpText="{Binding Path}"
                                    Padding="10,5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                      <StackPanel Spacing="1">
                        <TextBlock Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding $parent[Button].Foreground}" />
                        <TextBlock Classes="faint" Text="{Binding Path}" FontSize="10.5"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </c:OptionButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer x:Name="SidebarScroll" HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto" IsVisible="{Binding !Search.IsActive}">
            <ItemsControl x:Name="SidebarList" ItemsSource="{Binding Categories}" Margin="10,10,10,16">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="12" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SettingsCategory">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="sidebar-heading" Text="{Binding Label}" />
                    <ItemsControl ItemsSource="{Binding Sections}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="2" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SettingsSection">
                          <c:OptionButton Classes="option wide" Classes.on="{Binding IsSelected}" IsSelected="{Binding IsSelected}"
                                          AutomationProperties.Name="{Binding Label}"
                                          Click="OnSectionClick"
                                          Height="30"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <TextBlock Text="{Binding Label}" FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{Binding $parent[Button].Foreground}" />
                          </c:OptionButton>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          </Panel>
          </DockPanel>
        </Border>

        <!-- Treść; pasek przewijania jak w kolejce, zamiast domyślnego z motywu Fluent -->
        <Panel Grid.Column="1">
          <ScrollViewer x:Name="ContentArea"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Hidden">
            <Panel Margin="24,20,30,26">

              <!-- ========== Wygląd ========== -->
              <StackPanel Spacing="18" Tag="SectionAppearance" IsVisible="{Binding Appearance.IsSelected}">
                <!-- Bez tytułu karty: nazwę sekcji podaje zakładka po lewej, na tej samej
                     wysokości -->
                <Border Classes="section">
                  <StackPanel Spacing="16">
                    <StackPanel Spacing="8">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingTheme}" />
                      <c:SegmentBar Group="{Binding Theme}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingWindowControls}" />
                      <c:SegmentBar Group="{Binding WindowControls}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingEffects}" />
                      <c:SegmentBar Group="{Binding Effects}" />
                      <TextBlock Classes="setting-hint" Text="{l:Translate HintEffects}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingColours}" />
                      <c:SegmentBar Group="{Binding Colours}" />
                      <TextBlock Classes="setting-hint" Text="{l:Translate HintColours}" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,16,0">
                        <TextBlock Classes="setting-label" Text="{l:Translate SettingFormatBadge}" />
                        <TextBlock Classes="setting-hint" Text="{l:Translate HintFormatBadge}" />
                      </StackPanel>
                      <c:GlassSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding ShowFormatBadge, Mode=TwoWay}"
                                     AutomationProperties.Name="{l:Translate SettingFormatBadge}"
                                     OffBrush="{DynamicResource TrackBrush}"
                                     OnBrush="{DynamicResource AccentBrush}"
                                     BorderBrush="{DynamicResource StrokeBrush}" />
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- Boczny panel kolejki i stacji: wysuwanie i chowanie. Szerokość i przypięcie
                     zapamiętuje sam panel, bez osobnych kontrolek. -->
                <Border x:Name="QueuePanelCard" Classes="section">
                  <StackPanel Spacing="16">
                    <StackPanel Spacing="3">
                      <TextBlock Classes="section-title" Text="{l:Translate QueuePanelHeading}" />
                      <TextBlock Classes="setting-hint" Text="{l:Translate HintQueuePanel}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingQueueReveal}" />
                      <c:SegmentBar Group="{Binding QueueRevealChoice}" />
                    </StackPanel>

                    <StackPanel Spacing="8" IsEnabled="{Binding QueueHoverOptionsEnabled}">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingQueueRevealDelay}" />
                      <c:SegmentBar Group="{Binding QueueRevealDelayChoice}" />
                    </StackPanel>

                    <StackPanel Spacing="8" IsEnabled="{Binding QueueHoverOptionsEnabled}">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingQueueHideDelay}" />
                      <c:SegmentBar Group="{Binding QueueHideDelayChoice}" />
                      <TextBlock Classes="setting-hint" Text="{l:Translate HintQueueHideDelay}" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- Barwa domyślnej okładki: każda pozycja pokazuje przejście barw takie,
                     jakie wyjdzie w bieżącym motywie -->
                <Border Classes="section">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="section-title" Text="{l:Translate SettingPlaceholder}" />
                    <TextBlock Classes="setting-hint" Text="{l:Translate HintPlaceholder}" />
                    <ItemsControl ItemsSource="{Binding Palettes}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PaletteOption">
                          <c:OptionButton Classes="option wide" Classes.on="{Binding IsSelected}" IsSelected="{Binding IsSelected}"
                                AutomationProperties.Name="{Binding Label}"
                                  Click="OnPaletteClick"
                                  Width="168" Height="34" Margin="0,0,8,6"
                                  HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                              <Border Width="34" Height="12" CornerRadius="6"
                                      VerticalAlignment="Center"
                                      Background="{Binding Preview}" />
                              <TextBlock Text="{Binding Label}" FontSize="11.5"
                                         TextTrimming="CharacterEllipsis"
                                         Foreground="{Binding $parent[Button].Foreground}" />
                            </StackPanel>
                          </c:OptionButton>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

              </StackPanel>

              <!-- ========== Język ========== -->
              <StackPanel Spacing="18" Tag="SectionLanguage" IsVisible="{Binding LanguageSection.IsSelected}">

                <!-- Lista, bo przy kilkunastu pozycjach pasek segmentów nie mieści się w wierszu.
                     Kafel ma 168 px, żeby przy domyślnej szerokości okna w wierszu stały trzy
                     pozycje; w oknie ściśniętym do minimum WrapPanel zwija je do dwóch. -->
                <Border Classes="section">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="section-title" Text="{l:Translate SettingLanguage}" />
                    <ItemsControl ItemsSource="{Binding Language.Options}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SegmentOption">
                          <c:OptionButton Classes="option wide" Classes.on="{Binding IsSelected}" IsSelected="{Binding IsSelected}"
                                AutomationProperties.Name="{Binding Label}"
                                  Click="OnLanguageClick"
                                  Width="168" Height="30" Margin="0,0,8,6"
                                  HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                              <!-- Flaga kraju języka; obrys, żeby białe pasy nie zlewały się z tłem. -->
                              <Border Width="20" Height="15" CornerRadius="2" ClipToBounds="True"
                                      VerticalAlignment="Center" IsVisible="{Binding HasIcon}"
                                      BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0.5">
                                <Image Source="{Binding Icon}" Stretch="UniformToFill"
                                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                              </Border>
                              <Ellipse Width="7" Height="7" Margin="6,0,7,0" VerticalAlignment="Center"
                                       IsVisible="{Binding !HasIcon}" />
                              <TextBlock Text="{Binding Label}" FontSize="11.5"
                                         TextTrimming="CharacterEllipsis"
                                         Foreground="{Binding $parent[Button].Foreground}" />
                            </StackPanel>
                          </c:OptionButton>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <!--
                  Skąd pochodzą tłumaczenia, przy wyborze języka, z odsyłaczem do zgłoszeń
                  poprawek na końcu.
                -->
                <Border Classes="section" IsVisible="{Binding ShowTranslationNote}">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="setting-hint" Text="{l:Translate HintMachineTranslation}" />
                    <Button Classes="link" Click="OnOpenIssues"
                            IsVisible="{Binding HasRepository}"
                            Content="{l:Translate LanguageReportLink}" />
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- ========== Dźwięk › Wyjście dźwięku ========== -->
              <StackPanel Spacing="18" Tag="SectionAudioOutput" IsVisible="{Binding Audio.IsSelected}">

                <Border Classes="section">
                  <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Classes="section-title"
                                 Text="{l:Translate SettingOutputDevice}" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="pill" Click="OnRefreshDevices"
                              Content="{l:Translate DeviceRefresh}"
                              AutomationProperties.Name="{l:Translate DeviceRefreshName}" />
                    </Grid>

                    <!-- Lista zamiast listy rozwijanej, bo urządzeń jest zwykle kilka. -->
                    <StackPanel Spacing="8">
                      <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Spacing="2" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:DeviceOption">
                            <c:OptionButton Classes="option wide" Classes.on="{Binding IsSelected}" IsSelected="{Binding IsSelected}"
                                AutomationProperties.Name="{Binding Label}"
                                    Click="OnDeviceClick"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                              <StackPanel Orientation="Horizontal" Spacing="9">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" FontSize="11.5"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{Binding $parent[Button].Foreground}" />
                              </StackPanel>
                            </c:OptionButton>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Classes="setting-hint" Text="{Binding ActiveDeviceName}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingLatency}" />
                      <c:SegmentBar Group="{Binding Latency}" />
                      <TextBlock Classes="setting-hint" Text="{l:Translate HintLatency}" />
                      <TextBlock Classes="faint" FontSize="10.5" Text="{Binding LatencyDescription}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingQuality}" />
                      <c:SegmentBar Group="{Binding Quality}" />
                      <TextBlock Classes="setting-hint" Text="{l:Translate HintQuality}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- ========== Dźwięk › Korektor i efekty ========== -->
              <StackPanel x:Name="ProcessingPage" Spacing="18" Tag="SectionEqualiser" IsVisible="{Binding Processing.IsSelected}">
                <!-- Ten sam panel co w oknie „Korektor i efekty”, tu karty jedna pod drugą i z opisami efektów. -->
                <v:SoundPanel x:Name="SettingsSoundPanel" Stacked="True" ShowDescriptions="True"
                              DataContext="{Binding Player}" />

                <Border Classes="section">
                  <StackPanel Spacing="16">
                    <TextBlock Classes="section-title" Text="{l:Translate SectionProcessing}" />

                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                        <TextBlock Classes="setting-label" Text="{l:Translate OptionNormalisation}" />
                        <TextBlock Classes="setting-hint" Text="{l:Translate HintNormalisation}" />
                      </StackPanel>
                      <c:GlassSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding NormalisationEnabled, Mode=TwoWay}"
                                     AutomationProperties.Name="{l:Translate OptionNormalisation}"
                                     OffBrush="{DynamicResource TrackBrush}"
                                     OnBrush="{DynamicResource AccentBrush}"
                                     BorderBrush="{DynamicResource StrokeBrush}" />
                    </Grid>

                    <StackPanel Classes="setting" Spacing="8" IsEnabled="{Binding NormalisationEnabled}">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingLoudnessTarget}" />
                      <c:SegmentBar Group="{Binding Loudness}" />
                      <TextBlock Classes="setting-hint" Text="{l:Translate HintLoudnessTarget}" />
                    </StackPanel>

                    <Grid Classes="setting" ColumnDefinitions="*,Auto" IsEnabled="{Binding NormalisationEnabled}">
                      <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                        <TextBlock Classes="setting-label" Text="{l:Translate OptionAlwaysAnalyse}" />
                        <TextBlock Classes="setting-hint" Text="{l:Translate HintAlwaysAnalyse}" />
                      </StackPanel>
                      <c:GlassSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding AlwaysAnalyse, Mode=TwoWay}"
                                     AutomationProperties.Name="{l:Translate OptionAlwaysAnalyse}"
                                     OffBrush="{DynamicResource TrackBrush}"
                                     OnBrush="{DynamicResource AccentBrush}"
                                     BorderBrush="{DynamicResource StrokeBrush}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                        <TextBlock Classes="setting-label" Text="{l:Translate OptionLimiter}" />
                        <TextBlock Classes="setting-hint" Text="{l:Translate HintLimiter}" />
                      </StackPanel>
                      <c:GlassSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding LimiterEnabled, Mode=TwoWay}"
                                     AutomationProperties.Name="{l:Translate OptionLimiter}"
                                     OffBrush="{DynamicResource TrackBrush}"
                                     OnBrush="{DynamicResource AccentBrush}"
                                     BorderBrush="{DynamicResource StrokeBrush}" />
                    </Grid>

                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- ========== Dźwięk › Odtwarzanie ========== -->
              <StackPanel Spacing="18" Tag="SectionPlayback" IsVisible="{Binding Playback.IsSelected}">
                <Border Classes="section">
                  <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                        <TextBlock Classes="setting-label" Text="{l:Translate SettingRestoreSession}" />
                        <TextBlock Classes="setting-hint" Text="{l:Translate HintRestoreSession}" />
                      </StackPanel>
                      <c:GlassSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding RestoreSessionEnabled, Mode=TwoWay}"
                                     AutomationProperties.Name="{l:Translate SettingRestoreSession}"
                                     OffBrush="{DynamicResource TrackBrush}"
                                     OnBrush="{DynamicResource AccentBrush}"
                                     BorderBrush="{DynamicResource StrokeBrush}" />
                    </Grid>

                    <StackPanel Spacing="8">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingSeekStep}" />
                      <c:SegmentBar Group="{Binding SeekStep}" />
                      <TextBlock Classes="setting-hint" Text="{l:Translate HintSeekStep}" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                        <TextBlock Classes="setting-label" Text="{l:Translate SettingSoftPause}" />
                        <TextBlock Classes="setting-hint" Text="{l:Translate HintSoftPause}" />
                      </StackPanel>
                      <c:GlassSwitch x:Name="SoftPauseSwitch" Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding SoftPause, Mode=TwoWay}"
                                     AutomationProperties.Name="{l:Translate SettingSoftPause}"
                                     OffBrush="{DynamicResource TrackBrush}"
                                     OnBrush="{DynamicResource AccentBrush}"
                                     BorderBrush="{DynamicResource StrokeBrush}" />
                    </Grid>

                    <StackPanel Spacing="8">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingFileOpen}" />
                      <c:SegmentBar Group="{Binding FileOpen}" />
                      <TextBlock Classes="setting-hint" Text="{l:Translate HintFileOpen}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- ========== Scena › Pełny ekran ========== -->
              <StackPanel Spacing="18" Tag="SectionFullScreen" IsVisible="{Binding SceneFullScreen.IsSelected}">
                <Border Classes="section">
                  <StackPanel Spacing="16">
                    <StackPanel Spacing="8">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingSceneVisual}" />
                      <c:SegmentBar Group="{Binding SceneVisualChoice}" />
                      <c:SegmentBar Group="{Binding SceneVisualReactiveChoice}" />
                      <TextBlock Classes="setting-hint" Text="{l:Translate HintSceneVisual}" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                        <TextBlock Classes="setting-label" Text="{l:Translate SettingSceneNext}" />
                        <TextBlock Classes="setting-hint" Text="{l:Translate HintSceneNext}" />
                      </StackPanel>
                      <c:GlassSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding SceneShowNext, Mode=TwoWay}"
                                     AutomationProperties.Name="{l:Translate SettingSceneNext}"
                                     OffBrush="{DynamicResource TrackBrush}"
                                     OnBrush="{DynamicResource AccentBrush}"
                                     BorderBrush="{DynamicResource StrokeBrush}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                        <TextBlock Classes="setting-label" Text="{l:Translate SettingKeepAwake}" />
                        <TextBlock Classes="setting-hint" Text="{l:Translate HintKeepAwake}" />
                      </StackPanel>
                      <c:GlassSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding KeepScreenAwake, Mode=TwoWay}"
                                     AutomationProperties.Name="{l:Translate SettingKeepAwake}"
                                     OffBrush="{DynamicResource TrackBrush}"
                                     OnBrush="{DynamicResource AccentBrush}"
                                     BorderBrush="{DynamicResource StrokeBrush}" />
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- Napisy i wielkość płyty w Płycie, Okładce i radiu. -->
                <Border x:Name="SceneTextCard" Classes="section">
                  <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="section-title" Text="{l:Translate SceneTextHeading}" />
                      <TextBlock Classes="setting-hint" Text="{l:Translate HintSceneText}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingSceneTextSize}" />
                      <c:SegmentBar Group="{Binding SceneTextSizeChoice}" />
                      <TextBlock Classes="setting-hint" Text="{l:Translate HintSceneTextSize}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingSceneTextPosition}" />
                      <c:SegmentBar Group="{Binding SceneTextPositionChoice}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingSceneTextAlign}" />
                      <c:SegmentBar Group="{Binding SceneTextAlignChoice}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingSceneTextInset}" />
                      <c:SegmentBar Group="{Binding SceneTextInsetChoice}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingSceneArtSize}" />
                      <c:SegmentBar Group="{Binding SceneArtSizeChoice}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- ========== Scena › Wizualizacje i efekty ========== -->
              <StackPanel Spacing="18" Tag="SectionSceneVisuals" IsVisible="{Binding SceneVisuals.IsSelected}">
                <!-- Wizualizacje pod klawiszem V: wyłączoną V pomija, Płyta zostaje zawsze. -->
                <Border x:Name="SceneCycleCard" Classes="section">
                  <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="section-title" Text="{l:Translate SceneCycleHeading}" />
                      <TextBlock Classes="setting-hint" Text="{l:Translate HintSceneCycle}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding SceneCycleOptions}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="10" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SceneCycleOption">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="setting-label" Text="{Binding Label}" VerticalAlignment="Center" />
                            <c:GlassSwitch Grid.Column="1" VerticalAlignment="Center"
                                           IsChecked="{Binding IsOn, Mode=TwoWay}"
                                           AutomationProperties.Name="{Binding Label}"
                                           OffBrush="{DynamicResource TrackBrush}"
                                           OnBrush="{DynamicResource AccentBrush}"
                                           BorderBrush="{DynamicResource StrokeBrush}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <Border Classes="section">
                  <StackPanel Spacing="16">
                    <StackPanel Spacing="8">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingSpectrumShape}" />
                      <c:SegmentBar Group="{Binding SpectrumShapeChoice}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingWaveKind}" />
                      <c:SegmentBar Group="{Binding WaveformKindChoice}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingDiscRing}" />
                      <c:SegmentBar Group="{Binding DiscRingChoice}" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- Efekty tła Płyty i Okładki w barwach okładki: przełącznik i siła każdego. -->
                <Border x:Name="SceneEffectsCard" Classes="section">
                  <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="section-title" Text="{l:Translate SceneBackgroundHeading}" />
                      <TextBlock Classes="setting-hint" Text="{l:Translate HintSceneBackground}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding SceneEffectOptions}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="16" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SceneEffectOption">
                          <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                                <TextBlock Classes="setting-label" Text="{Binding Label}" />
                                <TextBlock Classes="setting-hint" Text="{Binding Hint}" />
                              </StackPanel>
                              <c:GlassSwitch Grid.Column="1" VerticalAlignment="Center"
                                             IsChecked="{Binding IsOn, Mode=TwoWay}"
                                             AutomationProperties.Name="{Binding Label}"
                                             OffBrush="{DynamicResource TrackBrush}"
                                             OnBrush="{DynamicResource AccentBrush}"
                                             BorderBrush="{DynamicResource StrokeBrush}" />
                            </Grid>
                            <c:SegmentBar Group="{Binding Strength}" IsEnabled="{Binding IsOn}" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <Border x:Name="SceneMotionCard" Classes="section">
                  <StackPanel Spacing="16">
                    <StackPanel Spacing="3">
                      <TextBlock Classes="section-title" Text="{l:Translate SceneMotionHeading}" />
                      <TextBlock Classes="setting-hint" Text="{l:Translate HintSceneMotion}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingDiscSpin}" />
                      <c:SegmentBar Group="{Binding DiscSpinChoice}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingBackdropMotion}" />
                      <c:SegmentBar Group="{Binding BackdropMotionChoice}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingSpectrumResponse}" />
                      <c:SegmentBar Group="{Binding SpectrumResponseChoice}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- ========== Scena › Telewizor ========== -->
              <StackPanel Spacing="18" Tag="SectionSceneTv" IsVisible="{Binding SceneTelevision.IsSelected}">
                <Border Classes="section">
                  <StackPanel Spacing="16">
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="setting-label" Text="{l:Translate SettingSceneScreen}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="pill" Click="OnRefreshScreens"
                                Content="{l:Translate DeviceRefresh}"
                                AutomationProperties.Name="{l:Translate ScreenRefreshName}" />
                      </Grid>
                      <ItemsControl ItemsSource="{Binding ScreenOptions}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Spacing="2" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ScreenOption">
                            <c:OptionButton Classes="option wide" Classes.on="{Binding IsSelected}" IsSelected="{Binding IsSelected}"
                                AutomationProperties.Name="{Binding Label}"
                                    Click="OnScreenClick"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                              <StackPanel Orientation="Horizontal" Spacing="9">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" FontSize="11.5"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{Binding $parent[Button].Foreground}" />
                              </StackPanel>
                            </c:OptionButton>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Classes="setting-hint" Text="{l:Translate HintSceneScreen}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingSceneMargin}" />
                      <c:SegmentBar Group="{Binding SceneMarginChoice}" />
                      <Button Classes="pill" HorizontalAlignment="Left" Click="OnFitEdges"
                              Content="{l:Translate SceneFitEdges}" />
                      <TextBlock Classes="setting-hint" Text="{l:Translate HintSceneMargin}" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                        <TextBlock Classes="setting-label" Text="{l:Translate SettingSceneOled}" />
                        <TextBlock Classes="setting-hint" Text="{l:Translate HintSceneOled}" />
                      </StackPanel>
                      <c:GlassSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding SceneOledCare, Mode=TwoWay}"
                                     AutomationProperties.Name="{l:Translate SettingSceneOled}"
                                     OffBrush="{DynamicResource TrackBrush}"
                                     OnBrush="{DynamicResource AccentBrush}"
                                     BorderBrush="{DynamicResource StrokeBrush}" />
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- ========== Radio › Stacje ========== -->
              <StackPanel x:Name="RadioSettings" Spacing="18" Tag="SectionRadioStations" IsVisible="{Binding RadioSection.IsSelected}">
                <Border Classes="section">
                  <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                        <TextBlock Classes="setting-label" Text="{l:Translate SettingRadioEnabled}" />
                        <TextBlock Classes="setting-hint" Text="{l:Translate HintRadioEnabled}" />
                      </StackPanel>
                      <c:GlassSwitch x:Name="RadioEnabledSwitch" Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding RadioEnabled, Mode=TwoWay}"
                                     AutomationProperties.Name="{l:Translate SettingRadioEnabled}"
                                     OffBrush="{DynamicResource TrackBrush}"
                                     OnBrush="{DynamicResource AccentBrush}"
                                     BorderBrush="{DynamicResource StrokeBrush}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding RadioOptionsEnabled}">
                      <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                        <TextBlock Classes="setting-label" Text="{l:Translate SettingRadioPlayAtStart}" />
                        <TextBlock Classes="setting-hint" Text="{l:Translate HintRadioPlayAtStart}" />
                      </StackPanel>
                      <c:GlassSwitch x:Name="RadioPlayAtStartSwitch" Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding RadioPlayAtStart, Mode=TwoWay}"
                                     AutomationProperties.Name="{l:Translate SettingRadioPlayAtStart}"
                                     OffBrush="{DynamicResource TrackBrush}"
                                     OnBrush="{DynamicResource AccentBrush}"
                                     BorderBrush="{DynamicResource StrokeBrush}" />
                    </Grid>

                    <StackPanel Spacing="8" IsEnabled="{Binding RadioOptionsEnabled}">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingRadioRecentLimit}" />
                      <c:SegmentBar Group="{Binding RadioRecentLimitChoice}" />
                      <TextBlock Classes="setting-hint" Text="{l:Translate HintRadioRecentLimit}" />
                    </StackPanel>

                    <StackPanel Spacing="8" IsEnabled="{Binding RadioOptionsEnabled}">
                      <TextBlock Classes="setting-hint" Text="{l:Translate HintRadioClearRecent}" />
                      <Button x:Name="RadioClearRecentButton" Classes="pill" Height="26" Padding="14,0"
                              HorizontalAlignment="Left"
                              Click="OnRadioClearRecent" Content="{l:Translate RadioClearRecent}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- ========== Radio › Logo i prywatność ========== -->
              <StackPanel x:Name="RadioLogoSettings" Spacing="18" Tag="SectionRadioLogos" IsVisible="{Binding RadioLogos.IsSelected}">
                <Border Classes="section">
                  <StackPanel Spacing="14" IsEnabled="{Binding RadioOptionsEnabled}">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                        <TextBlock Classes="setting-label" Text="{l:Translate SettingRadioLogos}" />
                        <TextBlock Classes="setting-hint" Text="{l:Translate HintRadioLogos}" />
                      </StackPanel>
                      <c:GlassSwitch x:Name="RadioLogosSwitch" Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding RadioLogosEnabled, Mode=TwoWay}"
                                     AutomationProperties.Name="{l:Translate SettingRadioLogos}"
                                     OffBrush="{DynamicResource TrackBrush}"
                                     OnBrush="{DynamicResource AccentBrush}"
                                     BorderBrush="{DynamicResource StrokeBrush}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <Button x:Name="RadioClearLogosButton" Classes="pill" Height="26" Padding="14,0"
                              Click="OnRadioClearLogos" Content="{l:Translate RadioClearLogos}" />
                      <TextBlock x:Name="RadioLogoCacheLabel" Classes="setting-hint" VerticalAlignment="Center"
                                 Text="{Binding RadioLogoCacheText}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- ========== Ogólne › Integracja z systemem ========== -->
              <StackPanel Spacing="18" Tag="SectionSystem" IsVisible="{Binding Integration.IsSelected}">
                <Border Classes="section">
                  <StackPanel Spacing="16">
                    <Grid Classes="setting" ColumnDefinitions="*,Auto" IsEnabled="{Binding MediaKeysSupported}">
                      <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                        <TextBlock Classes="setting-label" Text="{l:Translate SettingMediaKeys}" />
                        <TextBlock Classes="setting-hint" Text="{l:Translate HintMediaKeys}" />
                      </StackPanel>
                      <c:GlassSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding MediaKeysEnabled, Mode=TwoWay}"
                                     AutomationProperties.Name="{l:Translate SettingMediaKeys}"
                                     OffBrush="{DynamicResource TrackBrush}"
                                     OnBrush="{DynamicResource AccentBrush}"
                                     BorderBrush="{DynamicResource StrokeBrush}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                        <TextBlock Classes="setting-label" Text="{l:Translate SettingSingleInstance}" />
                        <TextBlock Classes="setting-hint" Text="{l:Translate HintSingleInstance}" />
                      </StackPanel>
                      <c:GlassSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding SingleInstanceEnabled, Mode=TwoWay}"
                                     AutomationProperties.Name="{l:Translate SettingSingleInstance}"
                                     OffBrush="{DynamicResource TrackBrush}"
                                     OnBrush="{DynamicResource AccentBrush}"
                                     BorderBrush="{DynamicResource StrokeBrush}" />
                    </Grid>

                    <StackPanel Spacing="3">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingMediaPanel}" />
                      <TextBlock Classes="setting-hint" Text="{Binding MediaPanelText}" />
                    </StackPanel>

                    <StackPanel Spacing="9" IsVisible="{Binding AssociationsSupported}">
                      <TextBlock Classes="setting-label" Text="{l:Translate SettingAssociations}" />
                      <TextBlock Classes="setting-hint" Text="{Binding AssociationStatus}" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="pill" Height="26" Padding="14,0"
                                Click="OnRegisterAssociations"
                                IsEnabled="{Binding CanRegisterAssociations}"
                                Content="{l:Translate AssociationsRegister}" />
                        <Button Classes="pill" Height="26" Padding="14,0"
                                Click="OnRemoveAssociations"
                                IsEnabled="{Binding CanRemoveAssociations}"
                                Content="{l:Translate AssociationsRemove}" />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- ========== O programie › Informacje ========== -->
              <StackPanel Spacing="18" Tag="SectionAboutInfo" IsVisible="{Binding About.IsSelected}">
                <Border Classes="section">
                  <StackPanel Spacing="13">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="tabular dim" Text="{Binding VersionText}" FontSize="11" />
                      <TextBlock Classes="tabular faint" Text="{Binding AudioEngineText}" FontSize="10.5" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                      <TextBlock Classes="setting-label" Text="{l:Translate AboutAuthor}" />
                      <TextBlock Classes="setting-hint" Text="{Binding AuthorText}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                      <TextBlock Classes="setting-label" Text="{l:Translate AboutDecoders}" />
                      <TextBlock Classes="setting-hint" Text="{Binding DecodersText}" />
                      <TextBlock Classes="setting-hint" Text="{Binding SystemCodecsText}" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- Skróty klawiszowe okna głównego. -->
                <Border Classes="section">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="setting-label" Text="{l:Translate AboutShortcuts}" />
                    <ItemsControl x:Name="ShortcutList" ItemsSource="{Binding Shortcuts}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="5" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ShortcutRow">
                          <Grid ColumnDefinitions="150,*" ColumnSpacing="12">
                            <TextBlock Grid.Column="0" Classes="dim" Text="{Binding Keys}" FontSize="11.5"
                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Classes="setting-hint" Text="{Binding Action}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <!--
                  Karta druga: sprawdzanie nowszego wydania, osobno, bo wymaga decyzji.
                  Przycisk działa na żądanie, a przełącznik włącza sprawdzanie przy uruchomieniu.
                -->
                <Border Classes="section" IsVisible="{Binding CanCheckForUpdates}">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="setting-label" Text="{l:Translate AboutUpdates}" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <Button Classes="pill" Height="26" Padding="14,0"
                              Click="OnCheckForUpdates"
                              IsEnabled="{Binding NotChecking}"
                              Content="{l:Translate UpdateCheckNow}" />
                      <TextBlock Classes="setting-hint" VerticalAlignment="Center"
                                 IsVisible="{Binding HasUpdateStatus}"
                                 Text="{Binding UpdateStatus}" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,16,0">
                        <TextBlock Classes="setting-label" Text="{l:Translate SettingUpdateCheck}" />
                        <TextBlock Classes="setting-hint" Text="{l:Translate HintUpdateCheck}" />
                      </StackPanel>
                      <c:GlassSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding CheckForUpdatesEnabled, Mode=TwoWay}"
                                     AutomationProperties.Name="{l:Translate SettingUpdateCheck}"
                                     OffBrush="{DynamicResource TrackBrush}"
                                     OnBrush="{DynamicResource AccentBrush}"
                                     BorderBrush="{DynamicResource StrokeBrush}" />
                    </Grid>
                  </StackPanel>
                </Border>

                <!--
                  Karta ostatnia: repozytorium. Odsyłacze poza program na końcu zakładki.
                -->
                <Border Classes="section" IsVisible="{Binding HasRepository}">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="setting-label" Text="{l:Translate AboutRepository}" />
                    <StackPanel Orientation="Horizontal" Spacing="14">
                      <Button Classes="link" Click="OnOpenRepository"
                              Content="{Binding RepositoryLabel}" />
                      <Button Classes="link" Click="OnOpenReleases"
                              Content="{l:Translate AboutReleases}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- ========== O programie › Licencje składników ========== -->
              <StackPanel x:Name="LicencesPage" Spacing="18" Tag="SectionLicences" IsVisible="{Binding Licences.IsSelected}">
                <Border Classes="section">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="setting-label" Text="{l:Translate AboutLicences}" />
                    <TextBlock Classes="setting-hint" Text="{Binding LicenceText}" />
                  </StackPanel>
                </Border>

                <!-- Składniki innych autorów: lista, a po wybraniu nazwa licencji i jej pełny tekst. -->
                <Border Classes="section">
                  <v:LicencesView x:Name="LicencesList" />
                </Border>
              </StackPanel>

            </Panel>
          </ScrollViewer>

          <c:ThinScrollBar x:Name="ContentScrollBar"
                           HorizontalAlignment="Right" Margin="0,8,7,8"
                           TrackBrush="{DynamicResource TrackBrush}"
                           ThumbBrush="{DynamicResource Text3Brush}" />
        </Panel>
      </Grid>

    </DockPanel>
  </Border>

</v:AuxiliaryWindow>
