<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Cewka.App.Controls"
        xmlns:l="using:Cewka.App.Localisation"
        xmlns:vm="using:Cewka.App.ViewModels"
        x:Class="Cewka.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Cewka"
        Icon="avares://Cewka/Assets/cewka.png"
        Width="1180" Height="680"
        MinWidth="900" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        DragDrop.AllowDrop="True">

  <Border x:Name="Shell"
          CornerRadius="15"
          ClipToBounds="True"
          BorderBrush="{DynamicResource StrokeBrush}"
          BorderThickness="1"
          Background="{DynamicResource DeskBrush}">

    <Panel>

      <!-- ============ Warstwa 0: zywe tlo zbudowane z barw okladki ============ -->
      <c:LiveBackdrop x:Name="Backdrop"
                      Palette="{Binding Palette}"
                      MinimumStrength="{Binding BackdropMinimum}"
                      MaximumStrength="{Binding BackdropMaximum}"
                      Level="{Binding WaveLevel}"
                      IsActive="{Binding IsPlaying}"
                      IsReduced="{Binding ReducedEffects}"
                      BaseBrush="{DynamicResource DeskBrush}" />

      <!-- ============ Warstwa 1: przyciemnienie ============ -->
      <Border Background="{DynamicResource ScrimBrush}" />

      <!-- ============ Warstwa 2: tresc ============ -->
      <DockPanel>

        <!-- Pasek tytulu -->
        <Border x:Name="TitleBar"
                DockPanel.Dock="Top"
                Height="47"
                Background="{DynamicResource HeaderBarBrush}"
                BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="0,0,0,1">
          <Panel>

            <!-- Nazwa zawsze na srodku okna, niezaleznie od tego, po ktorej stronie
                 stoja przyciski okna. -->
            <TextBlock Text="{l:Translate AppName}" FontSize="13" FontWeight="Bold"
                       LetterSpacing="0.13"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />

            <DockPanel Margin="12,0,8,0">

              <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6"
                          VerticalAlignment="Center">
                <c:WindowButtons Position="{Binding WindowControls}"
                                 IsVisible="{Binding ControlsOnLeft}"
                                 Margin="0,0,6,0" />

                <Button Classes="icon" Width="30" Height="30"
                        Click="OnTogglePanel"
                        ToolTip.Tip="{l:Translate TooltipTogglePanel}">
                  <Viewbox Width="15" Height="15">
                    <Path Classes="fill" Data="{StaticResource IconMenu}" Width="16" Height="16" />
                  </Viewbox>
                </Button>
              </StackPanel>

              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6"
                          VerticalAlignment="Center">
                <Button Classes="icon" Width="30" Height="30"
                        Click="OnToggleTheme" ToolTip.Tip="{l:Translate TooltipTheme}">
                  <Viewbox Width="15" Height="15">
                    <Path Classes="stroke" Data="{StaticResource IconThemeStroke}"
                          Width="16" Height="16" StrokeThickness="1.3" />
                  </Viewbox>
                </Button>

                <Button Classes="icon" Width="30" Height="30"
                        Click="OnOpenSettings" ToolTip.Tip="{l:Translate TooltipSettings}">
                  <Viewbox Width="15" Height="15">
                    <Path Classes="fill" Data="{StaticResource IconSettings}" Width="16" Height="16" />
                  </Viewbox>
                </Button>

                <Rectangle Width="1" Height="18" Margin="6,0"
                           Fill="{DynamicResource StrokeBrush}"
                           IsVisible="{Binding ControlsOnRight}" />

                <c:WindowButtons Position="{Binding WindowControls}"
                                 IsVisible="{Binding ControlsOnRight}" />
              </StackPanel>

              <Panel />
            </DockPanel>
          </Panel>
        </Border>

        <!-- Panel korektora i kolejki -->
        <Border DockPanel.Dock="Bottom"
                IsVisible="{Binding PanelOpen}"
                Background="{DynamicResource GlassBrush}"
                BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="0,1,0,0">
          <Grid x:Name="PanelGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="524" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Korektor -->
            <Border Grid.Column="0" Padding="26,18,26,22"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,1,0">
              <DockPanel>

                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,15"
                      MinHeight="{StaticResource PanelHeaderRowHeight}">
                  <c:GlassSwitch Grid.Column="0"
                                 IsChecked="{Binding EqualiserEnabled, Mode=TwoWay}"
                                 OffBrush="{DynamicResource TrackBrush}"
                                 OnBrush="{DynamicResource AccentBrush}"
                                 BorderBrush="{DynamicResource StrokeBrush}"
                                 ToolTip.Tip="{l:Translate TooltipEqualiserSwitch}" />

                  <TextBlock x:Name="EqHeading" Grid.Column="1"
                             Text="{l:Translate Equaliser}" Margin="12,0,0,0"
                             FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center" />

                  <Border Grid.Column="3" Padding="3" CornerRadius="11"
                          Background="{DynamicResource GlassBrush}"
                          BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Button Classes="option" Classes.on="{Binding LimiterEnabled}"
                              Click="OnToggleLimiter"
                              ToolTip.Tip="{l:Translate TooltipLimiter}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Ellipse Width="7" Height="7" VerticalAlignment="Center" />
                          <TextBlock Text="{l:Translate OptionLimiter}" FontSize="11" FontWeight="Bold"
                                     Foreground="{Binding $parent[Button].Foreground}" />
                        </StackPanel>
                      </Button>
                      <Button Classes="option" Classes.on="{Binding NormalisationEnabled}"
                              Click="OnToggleNormalisation"
                              ToolTip.Tip="{l:Translate TooltipNormalisation}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Ellipse Width="7" Height="7" VerticalAlignment="Center" />
                          <TextBlock Text="{l:Translate OptionNormalisation}" FontSize="11" FontWeight="Bold"
                                     Foreground="{Binding $parent[Button].Foreground}" />
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Border>
                </Grid>

                <Grid ColumnDefinitions="46,Auto,*" Opacity="{Binding EqualiserOpacity}">

                  <!-- Preamp -->
                  <StackPanel Grid.Column="0" Spacing="8">
                    <TextBlock Classes="mono dim" Text="{Binding Preamp.GainText}"
                               FontSize="10.5" HorizontalAlignment="Center" />
                    <c:EqFader Height="116" HorizontalAlignment="Center"
                               Value="{Binding Preamp.Gain, Mode=TwoWay}"
                               ShowCentreLine="False"
                               TrackBrush="{DynamicResource TrackBrush}"
                               FillBrush="{DynamicResource AccentBrush}"
                               ThumbBrush="{DynamicResource FaderThumbBrush}"
                               ThumbBorderBrush="{DynamicResource FaderThumbBorderBrush}" />
                    <TextBlock Classes="mono faint" Text="{l:Translate Preamp}" FontSize="9.5"
                               LetterSpacing="0.4" HorizontalAlignment="Center" />
                  </StackPanel>

                  <Rectangle Grid.Column="1" Width="1" Margin="16,0"
                             Fill="{DynamicResource StrokeBrush}"
                             VerticalAlignment="Stretch" />

                  <!-- Pasma -->
                  <ItemsControl Grid.Column="2" ItemsSource="{Binding Bands}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:EqBandViewModel">
                        <StackPanel Spacing="8">
                          <TextBlock Classes="mono dim" Text="{Binding GainText}"
                                     FontSize="10.5" HorizontalAlignment="Center" />
                          <c:EqFader Height="116" HorizontalAlignment="Center"
                                     Value="{Binding Gain, Mode=TwoWay}"
                                     TrackBrush="{DynamicResource TrackBrush}"
                                     FillBrush="{DynamicResource FillBrush}"
                                     CentreLineBrush="{DynamicResource StrokeBrush}"
                                     ThumbBrush="{DynamicResource FaderThumbBrush}"
                                     ThumbBorderBrush="{DynamicResource FaderThumbBorderBrush}" />
                          <TextBlock Classes="mono faint" Text="{Binding Label}"
                                     FontSize="9.5" HorizontalAlignment="Center" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                </Grid>
              </DockPanel>
            </Border>

            <!-- Kolejka -->
            <DockPanel Grid.Column="1" Margin="20,18">

              <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto" Margin="6,0,6,10"
                    MinHeight="{StaticResource PanelHeaderRowHeight}">
                <TextBlock x:Name="QueueHeading" Grid.Column="0"
                           Text="{l:Translate Queue}" FontSize="13.5" FontWeight="Bold"
                           VerticalAlignment="Center" />

                <!-- Wczytanie i zapisanie listy odtwarzania -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2"
                            Margin="10,0,0,0" VerticalAlignment="Center">
                  <Button Classes="icon" Width="26" Height="26"
                          Click="OnLoadPlaylist" ToolTip.Tip="{l:Translate TooltipPlaylistLoad}">
                    <Viewbox Width="14" Height="14">
                      <Path Classes="stroke" Data="{StaticResource IconFolderStroke}"
                            Width="16" Height="16" />
                    </Viewbox>
                  </Button>
                  <Button Classes="icon" Width="26" Height="26"
                          IsEnabled="{Binding !IsQueueEmpty}"
                          Click="OnSavePlaylist" ToolTip.Tip="{l:Translate TooltipPlaylistSave}">
                    <Viewbox Width="13" Height="13">
                      <Path Classes="fill" Data="{StaticResource IconSave}"
                            Width="16" Height="16" />
                    </Viewbox>
                  </Button>
                </StackPanel>

                <TextBlock Grid.Column="3" Classes="mono faint" Text="{Binding QueueSummary}"
                           FontSize="10" VerticalAlignment="Center" Margin="0,3,0,0" />
              </Grid>

              <Panel x:Name="QueueHost" MaxHeight="176">
                <ListBox x:Name="QueueList"
                         Classes="queue"
                         Margin="0,0,12,0"
                         ItemsSource="{Binding Queue}"
                         SelectionChanged="OnQueueSelectionChanged"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PointerPressed="OnQueuePointerPressed"
                         PointerMoved="OnQueuePointerMoved"
                         PointerReleased="OnQueuePointerReleased">
                  <ListBox.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="{l:Translate QueueRemove}" Click="OnQueueRemove" />
                      <MenuItem Header="{l:Translate QueueMoveUp}" Click="OnQueueMoveUp" />
                      <MenuItem Header="{l:Translate QueueMoveDown}" Click="OnQueueMoveDown" />
                      <Separator />
                      <MenuItem Header="{l:Translate QueueClear}" Click="OnQueueClear" />
                    </ContextMenu>
                  </ListBox.ContextMenu>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:QueueItemViewModel">
                      <Grid ColumnDefinitions="16,*,Auto" Margin="10,9" ColumnSpacing="11"
                            Background="Transparent"
                            Classes.current="{Binding IsCurrent}"
                            ToolTip.Tip="{Binding Tooltip}" Opacity="{Binding RowOpacity}">
                        <Panel Grid.Column="0" Width="16" Height="16">
                          <TextBlock Classes="mono faint" Text="{Binding Number}"
                                     FontSize="10.5"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Opacity="{Binding NumberOpacity}" />
                          <Ellipse Width="6" Height="6"
                                   Fill="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Opacity="{Binding MarkerOpacity}" />
                        </Panel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Classes="row-title" Text="{Binding Title}"
                                     FontSize="12.5" LineHeight="17"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="faint" Text="{Binding Artist}" FontSize="10.5"
                                     LineHeight="15" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock Grid.Column="2" Classes="mono faint row-duration"
                                   Text="{Binding Duration}"
                                   FontSize="10" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <c:ThinScrollBar x:Name="QueueScrollBar"
                                 HorizontalAlignment="Right"
                                 TrackBrush="{DynamicResource TrackBrush}"
                                 ThumbBrush="{DynamicResource Text3Brush}" />
              </Panel>
            </DockPanel>
          </Grid>
        </Border>

        <!--
          Blok odtwarzania srodkowany w pozostalej przestrzeni. Przyklejenie go do dolu okna
          wygladalo poprawnie przy wysokosci projektowej, ale na pelnym ekranie zostawialo pod
          trescia pusty pas wysokosci kilkuset pikseli.
        -->
        <StackPanel x:Name="CentreArea" VerticalAlignment="Center">

        <!-- Odtwarzany utwor -->
        <Grid x:Name="NowPlaying" ColumnDefinitions="Auto,*" ColumnSpacing="48"
              Margin="40,38,40,18"
              HorizontalAlignment="Stretch">

          <!-- Plyta -->
          <Panel x:Name="DiscHost" Grid.Column="0" Width="300" Height="300"
                 PointerMoved="OnDiscPointerMoved" PointerExited="OnDiscPointerExited">

            <Ellipse Margin="14,0,14,-6" Height="34" VerticalAlignment="Bottom"
                     Fill="#73000000">
              <Ellipse.Effect>
                <BlurEffect Radius="18" />
              </Ellipse.Effect>
            </Ellipse>

            <c:VinylDisc x:Name="Disc"
                         Cover="{Binding Cover}"
                         CoreBrush="{DynamicResource DiscInnerBrush}"
                         BodyBrush="{DynamicResource DiscOuterBrush}"
                         GrooveBrush="{DynamicResource DiscGrooveBrush}"
                         RingBrush="{DynamicResource DiscRingBrush}"
                         HoleBrush="{DynamicResource DeskBrush}" />

            <!-- Refleks swietlny, nieruchomy wzgledem obracajacej sie plyty -->
            <Ellipse IsHitTestVisible="False">
              <Ellipse.Fill>
                <LinearGradientBrush StartPoint="5.9%,26.5%" EndPoint="94.1%,73.5%">
                  <GradientStop Color="#29FFFFFF" Offset="0" />
                  <GradientStop Color="#29FFFFFF" Offset="0.12" />
                  <GradientStop Color="#00FFFFFF" Offset="0.30" />
                  <GradientStop Color="#00FFFFFF" Offset="0.62" />
                  <GradientStop Color="#14FFFFFF" Offset="0.78" />
                  <GradientStop Color="#00FFFFFF" Offset="1" />
                </LinearGradientBrush>
              </Ellipse.Fill>
            </Ellipse>

            <c:DiscGlow x:Name="Glow" Margin="-6" />
          </Panel>

          <!-- Opis utworu i sterowanie -->
          <StackPanel x:Name="TrackInfo" Grid.Column="1" Spacing="5" VerticalAlignment="Center"
                      MaxWidth="900" HorizontalAlignment="Stretch">

            <Border HorizontalAlignment="Left" CornerRadius="5" Padding="7,3" Margin="0,0,0,3"
                    IsVisible="{Binding HasFormatBadge}"
                    Background="{DynamicResource Glass2Brush}"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
              <TextBlock Classes="mono dim" Text="{Binding FormatBadge}"
                         FontSize="9.5" LetterSpacing="0.57" />
            </Border>

            <!-- Bez jawnej wysokosci wiersza: narzucona wartosc obcinala dolne
                 wydluzenia liter przy wiekszych rozmiarach czcionki. -->
            <TextBlock x:Name="TrackTitle" Text="{Binding Title}"
                       FontSize="42" FontWeight="Bold"
                       LetterSpacing="-0.84" TextTrimming="CharacterEllipsis" />

            <TextBlock x:Name="TrackArtist" Classes="dim" Text="{Binding ArtistLine}" FontSize="17"
                       IsVisible="{Binding HasArtistLine}"
                       TextTrimming="CharacterEllipsis" />

            <!-- Widoczne tylko wtedy, gdy nie udalo sie otworzyc wyjscia dzwieku. Okno zostaje,
                 bo kolejka, ustawienia i sam powod nadal warte sa pokazania. -->
            <Border IsVisible="{Binding HasAudioFailure}"
                    Margin="0,10,0,0" Padding="12,9" CornerRadius="9"
                    HorizontalAlignment="Left" MaxWidth="640"
                    Background="{DynamicResource Glass2Brush}"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
              <TextBlock Text="{Binding AudioFailure}" FontSize="11.5" LineHeight="17"
                         TextWrapping="Wrap" Foreground="{DynamicResource Text2Brush}" />
            </Border>

            <!-- Nowsze wydanie. Zostaje na ekranie, bo opisuje stan, nie zdarzenie. -->
            <Border IsVisible="{Binding HasUpdateNotice}"
                    Margin="0,10,0,0" Padding="12,9" CornerRadius="9"
                    HorizontalAlignment="Left" MaxWidth="640"
                    Background="{DynamicResource Glass2Brush}"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{Binding UpdateNotice}" FontSize="11.5" LineHeight="17"
                           TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{DynamicResource Text2Brush}" />
                <Button Classes="link" VerticalAlignment="Center"
                        Click="OnOpenReleases" Content="{l:Translate UpdateNoticeLink}" />
              </StackPanel>
            </Border>

            <!-- Komunikat o wykonanej czynnosci; gasnie sam po kilku sekundach. -->
            <Border IsVisible="{Binding HasNotice}"
                    Margin="0,10,0,0" Padding="12,9" CornerRadius="9"
                    HorizontalAlignment="Left" MaxWidth="640"
                    Background="{DynamicResource Glass2Brush}"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
              <TextBlock Text="{Binding Notice}" FontSize="11.5" LineHeight="17"
                         TextWrapping="Wrap" Foreground="{DynamicResource Text2Brush}" />
            </Border>

            <!-- Widoczne tylko przy pustej kolejce: bez tego pierwsze uruchomienie
                 nie podpowiada, w jaki sposob dodac muzyke. -->
            <StackPanel IsVisible="{Binding IsQueueEmpty}" Spacing="10" Margin="0,10,0,0">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="pill" Height="30" Padding="16,0" Click="OnOpenFiles"
                        Content="{l:Translate OpenFiles}" />
                <Button Classes="pill" Height="30" Padding="16,0" Click="OnOpenFolder"
                        Content="{l:Translate OpenFolder}" />
              </StackPanel>
              <TextBlock Classes="faint" Text="{l:Translate DropHint}" FontSize="11.5" />
            </StackPanel>

            <!-- Pasek postepu -->
            <StackPanel Spacing="7" Margin="0,22,0,0">
              <Panel Height="44">
                <c:WaveformView x:Name="Wave" Stroke="{DynamicResource Text2Brush}"
                                IsActive="{Binding IsPlaying}" Level="{Binding WaveLevel}" />
                <c:TrackSlider x:Name="Seek" Height="16" VerticalAlignment="Center"
                               Value="{Binding Progress, Mode=TwoWay}"
                               Scrubbing="OnSeekScrubbing" Committed="OnSeekCommitted"
                               TrackBrush="{DynamicResource TrackBrush}"
                               FillBrush="{DynamicResource FillBrush}" />
              </Panel>

              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="mono faint" Text="{Binding Elapsed}" FontSize="11" />
                <TextBlock Grid.Column="1" Classes="mono faint" Text="{Binding Total}" FontSize="11" />
              </Grid>
            </StackPanel>

            <!-- Transport -->
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,18,0,0">

              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14"
                          VerticalAlignment="Center">
                <Button Classes="icon" Classes.active="{Binding ShuffleEnabled}"
                        Width="36" Height="36"
                        Click="OnToggleShuffle" ToolTip.Tip="{l:Translate TooltipShuffle}">
                  <Viewbox Width="17" Height="17">
                    <Path Classes="stroke" Data="{StaticResource IconShuffleStroke}"
                          Width="16" Height="16" />
                  </Viewbox>
                </Button>

                <Button Classes="icon strong" Width="38" Height="38"
                        Click="OnPrevious" ToolTip.Tip="{l:Translate TooltipPrevious}">
                  <Viewbox Width="19" Height="19" RenderTransformOrigin="50%,50%">
                    <Viewbox.RenderTransform>
                      <ScaleTransform ScaleX="-1" />
                    </Viewbox.RenderTransform>
                    <Path Classes="fill" Data="{StaticResource IconSkip}" Width="16" Height="16" />
                  </Viewbox>
                </Button>

                <Button Classes="play" Click="OnTogglePlay" ToolTip.Tip="{l:Translate TooltipPlayPause}">
                  <Panel>
                    <Viewbox Width="20" Height="20" IsVisible="{Binding IsPlaying}">
                      <Path Classes="fill" Data="{StaticResource IconPause}" Width="16" Height="16" />
                    </Viewbox>
                    <Viewbox Width="20" Height="20" Margin="2,0,0,0" IsVisible="{Binding IsPaused}">
                      <Path Classes="fill" Data="{StaticResource IconPlay}" Width="16" Height="16" />
                    </Viewbox>
                  </Panel>
                </Button>

                <Button Classes="icon strong" Width="38" Height="38"
                        Click="OnNext" ToolTip.Tip="{l:Translate TooltipNext}">
                  <Viewbox Width="19" Height="19">
                    <Path Classes="fill" Data="{StaticResource IconSkip}" Width="16" Height="16" />
                  </Viewbox>
                </Button>

                <!-- Trzy stany: bez powtarzania, kolejka, jeden utwor. Ikona z jedynka
                     odroznia ostatni od pozostalych, bo sam akcent tego nie pokaze. -->
                <Button Classes="icon" Classes.active="{Binding RepeatEnabled}"
                        Width="36" Height="36"
                        Click="OnToggleRepeat" ToolTip.Tip="{Binding RepeatTooltip}">
                  <Panel>
                    <Viewbox Width="17" Height="17" IsVisible="{Binding !RepeatTrack}">
                      <Path Classes="stroke" Data="{StaticResource IconRepeatStroke}"
                            Width="16" Height="16" />
                    </Viewbox>
                    <Viewbox Width="17" Height="17" IsVisible="{Binding RepeatTrack}">
                      <Path Classes="stroke" Data="{StaticResource IconRepeatOneStroke}"
                            Width="16" Height="16" />
                    </Viewbox>
                  </Panel>
                </Button>

                <!-- Dodanie plikow do kolejki; ostatni w rzedzie, bo nie nalezy do transportu -->
                <Button Classes="icon" Width="32" Height="32"
                        Click="OnOpenFiles" ToolTip.Tip="{l:Translate OpenFiles}">
                  <Viewbox Width="15" Height="15">
                    <Path Classes="fill" Data="{StaticResource IconFolder}" Width="16" Height="16" />
                  </Viewbox>
                </Button>
              </StackPanel>

              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="9"
                          VerticalAlignment="Center"
                          ToolTip.Tip="{l:Translate TooltipVolume}">
                <Viewbox Width="16" Height="16">
                  <Panel Width="16" Height="16">
                    <Path Classes="fill" Data="{StaticResource IconSpeaker}"
                          Fill="{DynamicResource Text2Brush}" Width="16" Height="16" />
                    <Path Classes="stroke" Data="{StaticResource IconSpeakerWavesStroke}"
                          Stroke="{DynamicResource Text2Brush}" StrokeThickness="1.3"
                          Width="16" Height="16" />
                  </Panel>
                </Viewbox>
                <c:TrackSlider x:Name="VolumeSlider" Width="104" Height="16"
                               Value="{Binding Volume, Mode=TwoWay}"
                               TrackBrush="{DynamicResource TrackBrush}"
                               FillBrush="{DynamicResource FillBrush}" />
              </StackPanel>
            </Grid>

          </StackPanel>
        </Grid>

        </StackPanel>

      </DockPanel>
    </Panel>
  </Border>

</Window>
