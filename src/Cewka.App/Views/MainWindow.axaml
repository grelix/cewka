<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Cewka.App.Controls"
        xmlns:l="using:Cewka.App.Localisation"
        xmlns:vm="using:Cewka.App.ViewModels"
        xmlns:v="using:Cewka.App.Views"
        x:Class="Cewka.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Cewka"
        Width="1200" Height="680"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        DragDrop.AllowDrop="True">

  <Border x:Name="Shell" Classes="shell">

    <Panel>

      <!-- ============ Warstwa 0: żywe tło z barw okładki ============ -->
      <c:LiveBackdrop x:Name="Backdrop"
                      Palette="{Binding Palette}"
                      MinimumStrength="{Binding BackdropMinimum}"
                      MaximumStrength="{Binding BackdropMaximum}"
                      Level="{Binding WaveLevel}"
                      IsActive="{Binding IsPlaying}"
                      IsReduced="{Binding ReducedEffects}"
                      BaseBrush="{DynamicResource DeskBrush}" />

      <!-- ============ Warstwa 1: przyciemnienie ============ -->
      <Border x:Name="Scrim" Background="{DynamicResource ScrimBrush}" />

      <!-- ============ Warstwa 2: treść ============ -->
      <DockPanel x:Name="WindowContent">

        <!-- Pasek tytułu: po prawej polecenia i przyciski okna, po lewej nic albo przyciski okna. -->
        <Border x:Name="TitleBar"
                DockPanel.Dock="Top"
                Height="47"
                Background="{DynamicResource HeaderBarBrush}"
                BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="0,0,0,1">
          <Panel>

            <!-- Nazwa zawsze na środku okna, bez względu na to, po której stronie
                 stoją przyciski okna. -->
            <TextBlock Text="{l:Translate AppName}" FontSize="13" FontWeight="Bold"
                       LetterSpacing="0.13" IsHitTestVisible="False"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />

            <DockPanel Margin="12,0,8,0">

              <c:WindowButtons DockPanel.Dock="Left" VerticalAlignment="Center"
                               Position="{Binding WindowControls}"
                               IsVisible="{Binding ControlsOnLeft}" />

              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6"
                          VerticalAlignment="Center">

                <!--
                  Przycisk menu (decyzja 9a): ustawienia, korektor, kolejka i wybór źródła rozsuwają się w bok,
                  z krótką animacją, a zwijają po użyciu ikony, kliknięciu poza nimi i klawiszu Esc.
                -->
                <Border x:Name="MenuTray" Width="0" Opacity="0" ClipToBounds="True" IsHitTestVisible="False">
                  <StackPanel x:Name="MenuTrayItems" Orientation="Horizontal" Spacing="6" IsEnabled="False"
                              HorizontalAlignment="Right">
                    <Button x:Name="SettingsButton" Classes="icon" Width="30" Height="30"
                            Click="OnOpenSettings"
                            ToolTip.Tip="{l:Translate TooltipSettings}"
                            AutomationProperties.Name="{l:Translate TooltipSettings}">
                      <Viewbox Width="15" Height="15">
                        <Path Classes="stroke" Data="{StaticResource IconGearStroke}"
                              Width="16" Height="16" StrokeThickness="1.2" />
                      </Viewbox>
                    </Button>

                    <ToggleButton x:Name="PanelToggle" Classes="icon" Width="30" Height="30"
                                  IsChecked="{Binding PanelOpen, Mode=TwoWay}"
                                  ToolTip.Tip="{l:Translate TooltipTogglePanel}"
                                  AutomationProperties.Name="{l:Translate TooltipTogglePanel}">
                      <Panel Width="30" Height="30">
                        <Viewbox Width="15" Height="15">
                          <Path Classes="stroke" Data="{StaticResource IconFadersStroke}"
                                Width="16" Height="16" StrokeThickness="1.3" />
                        </Viewbox>
                        <Ellipse Classes="indicator" IsVisible="{Binding ShowProcessingDot}" />
                      </Panel>
                    </ToggleButton>

                    <ToggleButton x:Name="QueueToggle" Classes="icon" Width="30" Height="30"
                                  IsChecked="{Binding QueuePinned, Mode=TwoWay}"
                                  ToolTip.Tip="{l:Translate TooltipToggleQueue}"
                                  AutomationProperties.Name="{l:Translate TooltipToggleQueue}">
                      <Viewbox Width="15" Height="15">
                        <Path Classes="stroke" Data="{StaticResource IconQueueStroke}"
                              Width="16" Height="16" StrokeThickness="1.3" />
                      </Viewbox>
                    </ToggleButton>

                    <!--
                      Dwa przełączniki dla dwóch niezależnych obszarów: suwaki to pas dolny
                      z korektorem i efektami, lista to kolejka po prawej.
                    -->
                    <!-- Źródło dźwięku: dwie ikony obok siebie, włączona podświetlona. -->
                    <StackPanel x:Name="SourceSwitch" Orientation="Horizontal" Spacing="2" Margin="0,0,0,0" IsVisible="{Binding RadioAvailable}"
                                AutomationProperties.Name="{l:Translate SourceGroup}">
                      <Button x:Name="SourceFilesButton" Classes="icon" Classes.active="{Binding IsFilesMode}"
                              Width="30" Height="30" Click="OnSourceFiles"
                              ToolTip.Tip="{Binding SourceFilesTooltip}"
                              AutomationProperties.Name="{Binding SourceFilesTooltip}">
                        <Viewbox Width="15" Height="15">
                          <Path Classes="stroke" Data="{StaticResource IconFolderStroke}"
                                Width="16" Height="16" StrokeThickness="1.2" />
                        </Viewbox>
                      </Button>
                      <Button x:Name="SourceRadioButton" Classes="icon" Classes.active="{Binding IsRadioMode}"
                              Width="30" Height="30" Click="OnSourceRadio"
                              ToolTip.Tip="{Binding SourceRadioTooltip}"
                              AutomationProperties.Name="{Binding SourceRadioTooltip}">
                        <Viewbox Width="15" Height="15">
                          <Path Classes="stroke" Data="{StaticResource IconRadioStroke}"
                                Width="16" Height="16" StrokeThickness="1.2" />
                        </Viewbox>
                      </Button>
                    </StackPanel>

                  </StackPanel>
                </Border>

                <ToggleButton x:Name="MenuButton" Classes="icon" Width="30" Height="30"
                              Click="OnMenuButton"
                              ToolTip.Tip="{l:Translate TooltipMenu}"
                              AutomationProperties.Name="{l:Translate TooltipMenu}">
                  <Panel Width="30" Height="30">
                    <Viewbox Width="15" Height="15">
                      <Path Classes="stroke" Data="{StaticResource IconMenuStroke}"
                            Width="16" Height="16" StrokeThickness="1.3" />
                    </Viewbox>
                    <!-- Znak trybu przy zwiniętym menu: mała ikona radia, gdy gra radio. -->
                    <Border x:Name="MenuModeMark" IsVisible="False" IsHitTestVisible="False"
                            Width="13" Height="13" CornerRadius="7" Margin="0,2,2,0"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="{DynamicResource AccentBrush}">
                      <Viewbox Width="9" Height="9">
                        <Path Data="{StaticResource IconRadioStroke}" Width="16" Height="16" StrokeThickness="1.6"
                              Stroke="White" Fill="Transparent" />
                      </Viewbox>
                    </Border>
                  </Panel>
                </ToggleButton>

                <!-- Ikona pokazuje bieżący tryb: słońce, księżyc albo koło w połowie wypełnione. -->
                <Button x:Name="ThemeButton" Classes="icon" Width="30" Height="30"
                        Click="OnToggleTheme"
                        ToolTip.Tip="{Binding ThemeTooltip}"
                        AutomationProperties.Name="{Binding ThemeTooltip}">
                  <Panel>
                    <Viewbox Width="15" Height="15" IsVisible="{Binding ThemeIsLight}">
                      <Path Classes="stroke" Data="{StaticResource IconThemeStroke}"
                            Width="16" Height="16" StrokeThickness="1.3" />
                    </Viewbox>
                    <Viewbox Width="15" Height="15" IsVisible="{Binding ThemeIsDark}">
                      <Path Classes="stroke" Data="{StaticResource IconMoonStroke}"
                            Width="16" Height="16" StrokeThickness="1.3" />
                    </Viewbox>
                    <Viewbox Width="15" Height="15" IsVisible="{Binding ThemeIsSystem}">
                      <Panel Width="16" Height="16">
                        <Path Classes="stroke" Data="{StaticResource IconThemeAutoStroke}"
                              Width="16" Height="16" StrokeThickness="1.3" />
                        <Path Classes="fill" Data="{StaticResource IconThemeAutoHalf}"
                              Width="16" Height="16" />
                      </Panel>
                    </Viewbox>
                  </Panel>
                </Button>

                <Button x:Name="FullScreenButton" Classes="icon" Width="30" Height="30"
                        Click="OnFullScreen"
                        ToolTip.Tip="{l:Translate TooltipFullScreen}"
                        AutomationProperties.Name="{l:Translate TooltipFullScreen}">
                  <Viewbox Width="15" Height="15">
                    <Path Classes="stroke" Data="{StaticResource IconFullScreenStroke}"
                          Width="16" Height="16" StrokeThickness="1.3" />
                  </Viewbox>
                </Button>

                <c:WindowButtons Position="{Binding WindowControls}"
                                 IsVisible="{Binding ControlsOnRight}" />
              </StackPanel>

              <Panel />
            </DockPanel>
          </Panel>
        </Border>

        <!--
          Kolejka w kolumnie po prawej, gdy okno jest dość szerokie, a w węższym jako panel
          nakładany nad treść przy prawej krawędzi. Przełącza to kod, według szerokości okna.

          Kolejność w XAML to kolejność klawisza Tab: blok odtwarzania, kolejka, pas dolny.
          Nakładana kolejka przykrywa pas dzięki ZIndex.
        -->
        <Grid x:Name="Body" ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">

            <!--
              Blok odtwarzania wyśrodkowany w pozostałej przestrzeni. CentreHost zajmuje całą
              wolną wysokość, a według niej kod dobiera rozmiar płyty.

              ClipToBounds na wszelki wypadek: zawartość, która się nie zmieści, zostaje obcięta
              na swojej krawędzi zamiast rysować się na kolejce.
            -->
            <Panel x:Name="CentreHost" Grid.Row="0" Grid.Column="0">
              <StackPanel x:Name="CentreArea" VerticalAlignment="Center" ClipToBounds="True">

                <!-- Odtwarzany utwór. Przezroczyste tło łapie kursor dla poświaty płyty. -->
                <Grid x:Name="NowPlaying" ColumnDefinitions="Auto,*" ColumnSpacing="48"
                      Margin="40,38,40,18"
                      Background="Transparent"
                      HorizontalAlignment="Stretch"
                      PointerMoved="OnDiscPointerMoved" PointerExited="OnDiscPointerExited">

                  <!-- Płyta -->
                  <!-- Dwuklik w płytę otwiera scenę pełnoekranową. -->
                  <Panel x:Name="DiscHost" Grid.Column="0" Width="300" Height="300"
                         Background="Transparent" DoubleTapped="OnDiscDoubleTapped">

                    <!-- Cień pod płytą: miękki gradient, bo rozmycie liczyłoby się od nowa
                         przy każdej klatce obrotu. -->
                    <Ellipse Margin="0,0,0,-22" Height="64" VerticalAlignment="Bottom"
                             IsVisible="{Binding IsFilesMode}" IsHitTestVisible="False">
                      <Ellipse.Fill>
                        <RadialGradientBrush>
                          <GradientStop Color="#66000000" Offset="0" />
                          <GradientStop Color="#33000000" Offset="0.55" />
                          <GradientStop Color="#00000000" Offset="1" />
                        </RadialGradientBrush>
                      </Ellipse.Fill>
                    </Ellipse>

                    <!-- Tryb radia: bez płyty winylowej, logo stoi w ramce z lekkim cieniem (decyzja 14.3). -->
                    <Border x:Name="RadioLogoFrame" IsVisible="{Binding IsRadioMode}"
                            Width="260" Height="260" CornerRadius="22" ClipToBounds="True"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{DynamicResource Glass2Brush}"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                            BoxShadow="0 14 34 0 #33000000, 0 3 8 0 #1F000000">
                      <Panel>
                        <Image x:Name="RadioLogoImage" Source="{Binding Radio.StageLogo}"
                               IsVisible="{Binding Radio.HasStageLogo}" Stretch="Uniform" Margin="22"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <Viewbox x:Name="RadioLogoPlaceholder" Width="96" Height="96"
                                 IsVisible="{Binding Radio.ShowsStagePlaceholder}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                          <Path Classes="stroke" Data="{StaticResource IconRadioStroke}" Width="16" Height="16"
                                StrokeThickness="0.7" Stroke="{DynamicResource Text3Brush}" />
                        </Viewbox>
                      </Panel>
                    </Border>

                    <c:VinylDisc x:Name="Disc" IsVisible="{Binding IsFilesMode}"
                                 Cover="{Binding Cover}"
                                 CoreBrush="{DynamicResource DiscInnerBrush}"
                                 BodyBrush="{DynamicResource DiscOuterBrush}"
                                 GrooveBrush="{DynamicResource DiscGrooveBrush}"
                                 RingBrush="{DynamicResource DiscRingBrush}"
                                 HoleBrush="{DynamicResource DeskBrush}" />

                    <!-- Refleks świetlny, nieruchomy względem obracającej się płyty -->
                    <Ellipse IsVisible="{Binding IsFilesMode}" IsHitTestVisible="False">
                      <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="5.9%,26.5%" EndPoint="94.1%,73.5%">
                          <GradientStop Color="#29FFFFFF" Offset="0" />
                          <GradientStop Color="#29FFFFFF" Offset="0.12" />
                          <GradientStop Color="#00FFFFFF" Offset="0.30" />
                          <GradientStop Color="#00FFFFFF" Offset="0.62" />
                          <GradientStop Color="#14FFFFFF" Offset="0.78" />
                          <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                      </Ellipse.Fill>
                    </Ellipse>

                    <c:DiscGlow x:Name="Glow" Margin="-6" IsVisible="{Binding IsFilesMode}" />
                  </Panel>

                  <!-- Opis utworu i sterowanie -->
                  <StackPanel x:Name="TrackInfo" Grid.Column="1" Spacing="5" VerticalAlignment="Center"
                              MaxWidth="900" HorizontalAlignment="Stretch">

                    <!-- Bez jawnej wysokości wiersza, bo narzucona obcina dolne wydłużenia
                         liter przy większych rozmiarach pisma. -->
                    <TextBlock x:Name="TrackTitle" Text="{Binding ShownTitle}"
                               FontSize="42" FontWeight="Bold"
                               LetterSpacing="-0.84" TextTrimming="CharacterEllipsis" />

                    <!-- Wykonawca, a przy plikach zaraz za nim jakość źródła: mniejszym i cieńszym pismem,
                         przygaszona. Długi wiersz skraca wykonawcę, etykieta zostaje w całości. -->
                    <c:QualityRow x:Name="TrackLine">
                      <c:QualityRow.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                          <Binding Path="HasShownLine" />
                          <Binding Path="ShowsTrackQuality" />
                        </MultiBinding>
                      </c:QualityRow.IsVisible>
                      <TextBlock x:Name="TrackArtist" Classes="dim" Text="{Binding ShownLine}" FontSize="17"
                                 IsVisible="{Binding HasShownLine}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock x:Name="TrackQuality" Classes="faint" Text="{Binding FormatBadge}" FontSize="13.6"
                                 FontWeight="Light" IsVisible="{Binding ShowsTrackQuality}" />
                    </c:QualityRow>

                    <!-- Radio: błąd stacji z przyciskiem ponowienia, gdy ponowienie ma sens. -->
                    <Border x:Name="RadioFailure" IsVisible="{Binding Radio.HasError}"
                            Margin="0,10,0,0" Padding="12,9" CornerRadius="9"
                            HorizontalAlignment="Left" MaxWidth="640"
                            Background="{DynamicResource Glass2Brush}"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                      <StackPanel Spacing="8">
                        <TextBlock x:Name="RadioFailureText" Text="{Binding Radio.ErrorText}"
                                   FontSize="11.5" LineHeight="17"
                                   TextWrapping="Wrap" Foreground="{DynamicResource Text2Brush}"
                                   AutomationProperties.LiveSetting="Assertive" />
                        <Button x:Name="RadioRetryButton" Classes="pill" Click="OnRadioRetry"
                                IsVisible="{Binding Radio.CanRetry}"
                                HorizontalAlignment="Left"
                                Content="{l:Translate AudioRetry}" />
                      </StackPanel>
                    </Border>

                    <!-- Widoczne tylko wtedy, gdy nie udało się otworzyć wyjścia dźwięku. -->
                    <Border IsVisible="{Binding HasAudioFailure}"
                            Margin="0,10,0,0" Padding="12,9" CornerRadius="9"
                            HorizontalAlignment="Left" MaxWidth="640"
                            Background="{DynamicResource Glass2Brush}"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                      <StackPanel Spacing="8">
                        <TextBlock x:Name="AudioFailureText" Text="{Binding AudioFailure}"
                                   FontSize="11.5" LineHeight="17"
                                   TextWrapping="Wrap" Foreground="{DynamicResource Text2Brush}"
                                   AutomationProperties.LiveSetting="Assertive" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button x:Name="RetryAudioButton" Classes="pill" Click="OnRetryAudio"
                                  Content="{l:Translate AudioRetry}" />
                          <Button x:Name="ChooseDeviceButton" Classes="pill" Click="OnChooseDevice"
                                  Content="{l:Translate AudioChooseDevice}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <!-- Nowsze wydanie. Opisuje stan, więc zostaje na ekranie. -->
                    <Border IsVisible="{Binding HasUpdateNotice}"
                            Margin="0,10,0,0" Padding="12,9" CornerRadius="9"
                            HorizontalAlignment="Left" MaxWidth="640"
                            Background="{DynamicResource Glass2Brush}"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding UpdateNotice}" FontSize="11.5" LineHeight="17"
                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text2Brush}"
                                   AutomationProperties.LiveSetting="Polite" />
                        <Button Classes="link" VerticalAlignment="Center"
                                Click="OnOpenReleases" Content="{l:Translate UpdateNoticeLink}" />
                      </StackPanel>
                    </Border>

                    <!-- Komunikat o wykonanej czynności; gaśnie sam po kilku sekundach. -->
                    <Border IsVisible="{Binding HasNotice}"
                            Margin="0,10,0,0" Padding="12,9" CornerRadius="9"
                            HorizontalAlignment="Left" MaxWidth="640"
                            Background="{DynamicResource Glass2Brush}"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                      <TextBlock x:Name="NoticeText" Text="{Binding Notice}" FontSize="11.5" LineHeight="17"
                                 TextWrapping="Wrap" Foreground="{DynamicResource Text2Brush}"
                                 AutomationProperties.LiveSetting="Polite" />
                    </Border>

                    <!-- Widoczne tylko przy pustej kolejce: podpowiada, jak dodać muzykę. -->
                    <StackPanel x:Name="AddPrompt" IsVisible="{Binding ShowsAddPrompt}" Spacing="10" Margin="0,10,0,0">
                      <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="8">
                        <Button Classes="pill primary" Click="OnOpenFiles"
                                Content="{l:Translate OpenFiles}" />
                        <Button Classes="pill primary" Click="OnOpenFolder"
                                Content="{l:Translate OpenFolder}" />
                      </WrapPanel>
                      <TextBlock Classes="faint" Text="{l:Translate DropHint}" FontSize="11.5"
                                 TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Pasek postępu -->
                    <StackPanel x:Name="ProgressBlock" Spacing="7" Margin="0,22,0,0"
                                IsVisible="{Binding IsFilesMode}">
                      <Panel Height="44">
                        <c:WaveformView x:Name="Wave" Stroke="{DynamicResource Text2Brush}"
                                        IsActive="{Binding IsPlaying}"
                                        IsReduced="{Binding ReducedEffects}"
                                        Level="{Binding WaveLevel}" />
                        <c:TrackSlider x:Name="Seek" Height="16" VerticalAlignment="Center"
                                       Value="{Binding Progress, Mode=TwoWay}"
                                       Scrubbing="OnSeekScrubbing" Committed="OnSeekCommitted"
                                       AutomationProperties.Name="{l:Translate SeekPosition}"
                                       TrackBrush="{DynamicResource TrackBrush}"
                                       FillBrush="{DynamicResource FillBrush}" />
                      </Panel>

                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="tabular faint" Text="{Binding Elapsed}" FontSize="11" />
                        <TextBlock Grid.Column="1" Classes="tabular faint" Text="{Binding Total}" FontSize="11" />
                      </Grid>
                    </StackPanel>

                    <!-- Radio: zamiast suwaka postępu i czasu napis „Na żywo”, bez fokusu. -->
                    <Grid x:Name="LiveBlock" Margin="0,22,0,0" Height="67" IsVisible="{Binding IsRadioMode}">
                      <StackPanel VerticalAlignment="Center" Spacing="7">
                        <Border Height="2" CornerRadius="1" Background="{DynamicResource TrackBrush}" />
                        <!-- Przed napisem czerwona kropka, która pulsuje przy graniu; za nim jakość strumienia,
                             przygaszona mocniej niż napis. -->
                        <c:QualityRow x:Name="LiveLine" IsVisible="{Binding Radio.ShowsLiveCaption}">
                          <StackPanel Orientation="Horizontal">
                            <c:LiveDot x:Name="LiveDot" FontSize="{Binding #LiveCaption.FontSize}"
                                       Fill="{DynamicResource LiveDotBrush}"
                                       IsActive="{Binding IsPlaying}" IsReduced="{Binding ReducedEffects}" />
                            <TextBlock x:Name="LiveCaption" Classes="dim" Text="{l:Translate RadioLive}" FontSize="11" />
                          </StackPanel>
                          <TextBlock x:Name="LiveQuality" Classes="faint" Text="{Binding FormatBadge}" FontSize="11"
                                     IsVisible="{Binding HasFormatBadge}" />
                        </c:QualityRow>
                      </StackPanel>
                    </Grid>

                    <!-- Transport -->
                    <Grid x:Name="TransportRow" ColumnDefinitions="Auto,*,Auto" Margin="0,18,0,0">

                      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14"
                                  VerticalAlignment="Center">
                        <ToggleButton x:Name="ShuffleToggle" Classes="icon flat" Classes.active="{Binding ShuffleEnabled}"
                                      Opacity="{Binding FilesOnlyOpacity}" IsHitTestVisible="{Binding IsFilesMode}" Focusable="{Binding IsFilesMode}"
                                      Width="36" Height="36"
                                      IsChecked="{Binding ShuffleEnabled, Mode=TwoWay}"
                                      ToolTip.Tip="{l:Translate TooltipShuffle}"
                                      AutomationProperties.Name="{l:Translate TooltipShuffle}">
                          <Viewbox Width="17" Height="17">
                            <Path Classes="stroke" Data="{StaticResource IconShuffleStroke}"
                                  Width="16" Height="16" />
                          </Viewbox>
                        </ToggleButton>

                        <Button Classes="icon strong" Width="38" Height="38"
                                Click="OnPrevious" ToolTip.Tip="{l:Translate TooltipPrevious}"
                                AutomationProperties.Name="{l:Translate TooltipPrevious}">
                          <Viewbox Width="19" Height="19" RenderTransformOrigin="50%,50%">
                            <Viewbox.RenderTransform>
                              <ScaleTransform ScaleX="-1" />
                            </Viewbox.RenderTransform>
                            <Path Classes="fill" Data="{StaticResource IconSkip}" Width="16" Height="16" />
                          </Viewbox>
                        </Button>

                        <Button x:Name="PlayButton" Classes="play" Click="OnTogglePlay"
                                ToolTip.Tip="{Binding PlayPauseTooltip}"
                                AutomationProperties.Name="{Binding PlayPauseTooltip}">
                          <Panel>
                            <Viewbox Width="20" Height="20" IsVisible="{Binding ShowsPauseIcon}">
                              <Path Classes="fill" Data="{StaticResource IconPause}" Width="16" Height="16" />
                            </Viewbox>
                            <Viewbox Width="20" Height="20" IsVisible="{Binding ShowsStopIcon}">
                              <Path Classes="fill" Data="{StaticResource IconStop}" Width="16" Height="16" />
                            </Viewbox>
                            <Viewbox Width="20" Height="20" Margin="2,0,0,0" IsVisible="{Binding IsPaused}">
                              <Path Classes="fill" Data="{StaticResource IconPlay}" Width="16" Height="16" />
                            </Viewbox>
                          </Panel>
                        </Button>

                        <Button Classes="icon strong" Width="38" Height="38"
                                Click="OnNext" ToolTip.Tip="{l:Translate TooltipNext}"
                                AutomationProperties.Name="{l:Translate TooltipNext}">
                          <Viewbox Width="19" Height="19">
                            <Path Classes="fill" Data="{StaticResource IconSkip}" Width="16" Height="16" />
                          </Viewbox>
                        </Button>

                        <!-- Trzy stany: bez powtarzania, kolejka, jeden utwór. Ostatni odróżnia
                             ikona z jedynką, bo sam akcent tego nie pokaże. -->
                        <Button x:Name="RepeatModeButton" Classes="icon" Classes.active="{Binding RepeatEnabled}"
                                Opacity="{Binding FilesOnlyOpacity}" IsHitTestVisible="{Binding IsFilesMode}" Focusable="{Binding IsFilesMode}"
                                Width="36" Height="36"
                                Click="OnToggleRepeat" ToolTip.Tip="{Binding RepeatTooltip}"
                                AutomationProperties.Name="{Binding RepeatTooltip}">
                          <Panel>
                            <Viewbox Width="17" Height="17" IsVisible="{Binding !RepeatTrack}">
                              <Path Classes="stroke" Data="{StaticResource IconRepeatStroke}"
                                    Width="16" Height="16" />
                            </Viewbox>
                            <Viewbox Width="17" Height="17" IsVisible="{Binding RepeatTrack}">
                              <Path Classes="stroke" Data="{StaticResource IconRepeatOneStroke}"
                                    Width="16" Height="16" />
                            </Viewbox>
                          </Panel>
                        </Button>

                        <!-- Dodanie plików do kolejki; ostatni w rzędzie, bo nie należy do transportu -->
                        <Button Classes="icon" Width="32" Height="32"
                                Click="OnOpenFiles" ToolTip.Tip="{l:Translate TooltipOpenFiles}"
                                AutomationProperties.Name="{l:Translate TooltipOpenFiles}">
                          <Viewbox Width="15" Height="15">
                            <Path Classes="fill" Data="{StaticResource IconFolder}" Width="16" Height="16" />
                          </Viewbox>
                        </Button>
                      </StackPanel>

                      <!-- Głośnik wycisza i przywraca dźwięk; kółko nad suwakiem zmienia głośność o 5 %. -->
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5"
                                  VerticalAlignment="Center">
                        <Button x:Name="MuteButton" Classes="icon" Width="30" Height="30"
                                Click="OnToggleMute"
                                ToolTip.Tip="{Binding MuteTooltip}"
                                AutomationProperties.Name="{Binding MuteTooltip}">
                          <Viewbox Width="16" Height="16">
                            <Panel Width="16" Height="16">
                              <Path Classes="fill" Data="{StaticResource IconSpeaker}"
                                    Width="16" Height="16" />
                              <Path Classes="stroke" Data="{StaticResource IconSpeakerWavesStroke}"
                                    StrokeThickness="1.3" Width="16" Height="16"
                                    IsVisible="{Binding !IsMuted}" />
                              <Path Classes="stroke" Data="{StaticResource IconSpeakerMutedStroke}"
                                    StrokeThickness="1.3" Width="16" Height="16"
                                    IsVisible="{Binding IsMuted}" />
                            </Panel>
                          </Viewbox>
                        </Button>
                        <c:TrackSlider x:Name="VolumeSlider" Width="104" Height="16"
                                       Value="{Binding Volume, Mode=TwoWay}"
                                       WheelStep="0.05"
                                       Opacity="{Binding VolumeOpacity}"
                                       ToolTip.Tip="{l:Translate TooltipVolume}"
                                       AutomationProperties.Name="{Binding VolumeLevelText}"
                                       TrackBrush="{DynamicResource TrackBrush}"
                                       FillBrush="{DynamicResource FillBrush}" />
                      </StackPanel>
                    </Grid>

                  </StackPanel>
                </Grid>

              </StackPanel>
            </Panel>

          <!-- Kliknięcie obok nakładanej kolejki zamyka ją. -->
          <Border x:Name="QueueDismiss" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
                  ZIndex="1"
                  Background="Transparent" IsVisible="False"
                  PointerPressed="OnQueueDismissPressed" />

          <!--
            Uchwyt panelu przy prawej krawędzi: strefa najechania, cel dotykowy i przycisk dla klawiatury
            i czytnika ekranu. Najechanie wysuwa panel jako podgląd, kliknięcie przypina go jak klawisz L.
            Leży pod panelem, więc wysunięty panel go zakrywa, a kursor nad nim wciąż trzyma panel.
          -->
          <ToggleButton x:Name="QueueHandle" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
                        Classes="queue-handle" ZIndex="3"
                        Width="14" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                        IsChecked="{Binding QueuePinned, Mode=TwoWay}"
                        ToolTip.Tip="{Binding QueueHandleName}"
                        AutomationProperties.Name="{Binding QueueHandleName}">
            <Panel>
              <StackPanel VerticalAlignment="Center" Spacing="7">
                <!-- Znak radia nad pastylką, jak na przycisku menu. -->
                <Border x:Name="QueueHandleMark" IsVisible="{Binding IsRadioMode}" IsHitTestVisible="False"
                        Width="10" Height="10" CornerRadius="5" HorizontalAlignment="Right" Margin="0,0,3,0"
                        Background="{DynamicResource AccentBrush}">
                  <Viewbox Width="7" Height="7">
                    <Path Data="{StaticResource IconRadioStroke}" Width="16" Height="16" StrokeThickness="1.8"
                          Stroke="White" Fill="Transparent" />
                  </Viewbox>
                </Border>
                <Border x:Name="QueueHandlePill" Classes="handle-pill" HorizontalAlignment="Right" />
              </StackPanel>
            </Panel>
          </ToggleButton>

          <Border x:Name="QueueColumn" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Classes="queue-column"
                  ZIndex="4"
                  Width="320"
                  IsVisible="False">
           <Border.RenderTransform>
             <TranslateTransform />
           </Border.RenderTransform>
           <Panel>
           <!--
             Nakładany panel stoi nad treścią, więc pod nim nie ma tła okna. Ta warstwa rysuje kopię
             fragmentu żywego tła spod panelu z tym samym przyciemnieniem i szkłem co przypięta kolumna;
             treść okna pod panelem nie prześwituje. Wycinek ustawia kod (MainWindow.QueuePanel.cs).
           -->
           <Panel x:Name="QueueBackdropLayer" IsVisible="False" IsHitTestVisible="False">
             <Border x:Name="QueueBackdropCopy" />
             <Border Background="{DynamicResource ScrimBrush}" />
             <Border Background="{DynamicResource GlassBrush}" />
           </Panel>
           <DockPanel>

            <!--
              Stopka wspólna dla kolejki i stacji: polecenia z menu w pasku tytułu, żeby były pod ręką
              bez sięgania do niego. Przypinka zastępuje tu przełącznik kolejki.
            -->
            <Border x:Name="QueueFooter" DockPanel.Dock="Bottom" Height="44" Padding="18,0,14,0"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0">
              <DockPanel VerticalAlignment="Center">
                <StackPanel x:Name="FooterSourceSwitch" DockPanel.Dock="Left" Orientation="Horizontal" Spacing="2"
                            IsVisible="{Binding RadioAvailable}"
                            AutomationProperties.Name="{l:Translate SourceGroup}">
                  <Button x:Name="FooterFilesButton" Classes="icon" Classes.active="{Binding IsFilesMode}"
                          Width="30" Height="30" Click="OnSourceFiles"
                          ToolTip.Tip="{Binding SourceFilesTooltip}"
                          AutomationProperties.Name="{Binding SourceFilesTooltip}">
                    <Viewbox Width="15" Height="15">
                      <Path Classes="stroke" Data="{StaticResource IconFolderStroke}"
                            Width="16" Height="16" StrokeThickness="1.2" />
                    </Viewbox>
                  </Button>
                  <Button x:Name="FooterRadioButton" Classes="icon" Classes.active="{Binding IsRadioMode}"
                          Width="30" Height="30" Click="OnSourceRadio"
                          ToolTip.Tip="{Binding SourceRadioTooltip}"
                          AutomationProperties.Name="{Binding SourceRadioTooltip}">
                    <Viewbox Width="15" Height="15">
                      <Path Classes="stroke" Data="{StaticResource IconRadioStroke}"
                            Width="16" Height="16" StrokeThickness="1.2" />
                    </Viewbox>
                  </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                  <ToggleButton x:Name="FooterPanelToggle" Classes="icon" Width="30" Height="30"
                                IsChecked="{Binding PanelOpen, Mode=TwoWay}"
                                Click="OnFooterOpensWindow"
                                ToolTip.Tip="{l:Translate TooltipTogglePanel}"
                                AutomationProperties.Name="{l:Translate TooltipTogglePanel}">
                    <Panel Width="30" Height="30">
                      <Viewbox Width="15" Height="15">
                        <Path Classes="stroke" Data="{StaticResource IconFadersStroke}"
                              Width="16" Height="16" StrokeThickness="1.3" />
                      </Viewbox>
                      <Ellipse Classes="indicator" IsVisible="{Binding ShowProcessingDot}" />
                    </Panel>
                  </ToggleButton>

                  <Button x:Name="FooterSettingsButton" Classes="icon" Width="30" Height="30"
                          Click="OnFooterSettings"
                          ToolTip.Tip="{l:Translate TooltipSettings}"
                          AutomationProperties.Name="{l:Translate TooltipSettings}">
                    <Viewbox Width="15" Height="15">
                      <Path Classes="stroke" Data="{StaticResource IconGearStroke}"
                            Width="16" Height="16" StrokeThickness="1.2" />
                    </Viewbox>
                  </Button>

                  <ToggleButton x:Name="QueuePinToggle" Classes="icon" Width="30" Height="30"
                                IsChecked="{Binding QueuePinned, Mode=TwoWay}"
                                ToolTip.Tip="{l:Translate TooltipQueuePin}"
                                AutomationProperties.Name="{l:Translate TooltipQueuePin}">
                    <Viewbox Width="15" Height="15">
                      <Path Classes="stroke" Data="{StaticResource IconPinStroke}"
                            Width="16" Height="16" StrokeThickness="1.3" />
                    </Viewbox>
                  </ToggleButton>
                </StackPanel>

                <Panel />
              </DockPanel>
            </Border>

           <Panel>
            <DockPanel x:Name="QueueContent" Margin="18,16,14,12" IsVisible="{Binding IsFilesMode}">

              <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto" Margin="6,0,6,10"
                    MinHeight="{StaticResource PanelHeaderRowHeight}">
                <TextBlock x:Name="QueueHeading" Grid.Column="0"
                           Text="{l:Translate Queue}" FontSize="13.5" FontWeight="Bold"
                           VerticalAlignment="Center" />

                <!-- Wczytanie i zapisanie listy odtwarzania -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2"
                            Margin="10,0,0,0" VerticalAlignment="Center">
                  <Button Classes="icon" Width="26" Height="26"
                          Click="OnLoadPlaylist" ToolTip.Tip="{l:Translate TooltipPlaylistLoad}"
                          AutomationProperties.Name="{l:Translate TooltipPlaylistLoad}">
                    <Viewbox Width="14" Height="14">
                      <Path Classes="stroke" Data="{StaticResource IconFolderStroke}"
                            Width="16" Height="16" />
                    </Viewbox>
                  </Button>
                  <Button Classes="icon" Width="26" Height="26"
                          IsEnabled="{Binding !IsQueueEmpty}"
                          Click="OnSavePlaylist" ToolTip.Tip="{l:Translate TooltipPlaylistSave}"
                          AutomationProperties.Name="{l:Translate TooltipPlaylistSave}">
                    <Viewbox Width="13" Height="13">
                      <Path Classes="fill" Data="{StaticResource IconSave}"
                            Width="16" Height="16" />
                    </Viewbox>
                  </Button>
                </StackPanel>

                <TextBlock x:Name="QueueSummaryText" Grid.Column="3" Classes="tabular faint queue-summary"
                           Text="{Binding QueueSummary}"
                           FontSize="10" VerticalAlignment="Center" Margin="0,3,0,0" />
              </Grid>

              <Panel x:Name="QueueHost">
                <!--
                  Kliknięcie zaznacza wiersz, dwuklik i Enter go odtwarzają. Grany utwór ma własny
                  znacznik (kropka i pogrubienie), niezależny od zaznaczenia. Obsługa myszy
                  i klawiatury listy jest podpięta w kodzie.
                -->
                <ListBox x:Name="QueueList"
                         Classes="queue"
                         Margin="0,0,12,0"
                         SelectionMode="Single"
                         ItemsSource="{Binding Queue}"
                         AutomationProperties.Name="{l:Translate Queue}"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem" x:DataType="vm:QueueItemViewModel">
                      <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                    </Style>
                    <!-- W wąskim panelu kolumna czasu znika, a czas przechodzi do podpowiedzi wiersza. -->
                    <Style Selector="Grid.queue-row" x:DataType="vm:QueueItemViewModel">
                      <Setter Property="ToolTip.Tip" Value="{Binding Tooltip}" />
                    </Style>
                    <Style Selector="Border.queue-narrow Grid.queue-row" x:DataType="vm:QueueItemViewModel">
                      <Setter Property="ToolTip.Tip" Value="{Binding NarrowTooltip}" />
                    </Style>
                  </ListBox.Styles>
                  <ListBox.ContextMenu>
                    <ContextMenu x:Name="QueueMenu">
                      <!-- Nagłówki ze skrótami nadaje kod przy otwarciu menu, nazwami klawiszy ze słownika. -->
                      <ContextMenu.DataTemplates>
                        <DataTemplate DataType="vm:MenuCommandText">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" SharedSizeGroup="QueueMenuText" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Classes="faint" Text="{Binding Gesture}"
                                       Margin="24,0,0,0" VerticalAlignment="Center" />
                          </Grid>
                        </DataTemplate>
                      </ContextMenu.DataTemplates>
                      <MenuItem x:Name="QueuePlayItem" Click="OnQueuePlay" />
                      <MenuItem x:Name="QueueRemoveItem" Click="OnQueueRemove" />
                      <MenuItem x:Name="QueueMoveUpItem" Click="OnQueueMoveUp" />
                      <MenuItem x:Name="QueueMoveDownItem" Click="OnQueueMoveDown" />
                      <Separator />
                      <MenuItem x:Name="QueueUndoItem"
                                IsVisible="{Binding CanUndoQueue}"
                                Click="OnQueueUndo" />
                      <MenuItem Header="{l:Translate QueueClear}" Click="OnQueueClear"
                                IsEnabled="{Binding !IsQueueEmpty}" />
                    </ContextMenu>
                  </ListBox.ContextMenu>
                  <!--
                    Szerokość kolumny numerów liczy kod z liczby cyfr długości kolejki: jedna dla wszystkich
                    wierszy, więc numery stoją w równym rzędzie i żaden nie jest ucinany.
                  -->
                  <ListBox.Resources>
                    <x:Double x:Key="QueueNumberWidth">16</x:Double>
                  </ListBox.Resources>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:QueueItemViewModel">
                      <Grid Classes="queue-row" ColumnDefinitions="Auto,*,Auto" Margin="10,9" ColumnSpacing="11"
                            Background="Transparent"
                            Classes.current="{Binding IsCurrent}"
                            Opacity="{Binding RowOpacity}">
                        <Panel Grid.Column="0" Width="{DynamicResource QueueNumberWidth}" Height="16">
                          <TextBlock Classes="tabular faint" Text="{Binding Number}"
                                     FontSize="10.5"
                                     HorizontalAlignment="Right" VerticalAlignment="Center"
                                     Opacity="{Binding NumberOpacity}" />
                          <Ellipse Width="6" Height="6"
                                   Fill="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Opacity="{Binding MarkerOpacity}" />
                        </Panel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Classes="row-title" Text="{Binding Title}"
                                     FontSize="12.5" LineHeight="17"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="faint" Text="{Binding Artist}" FontSize="10.5"
                                     LineHeight="15" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock Grid.Column="2" Classes="tabular faint row-duration"
                                   Text="{Binding Duration}"
                                   FontSize="10" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <c:ThinScrollBar x:Name="QueueScrollBar"
                                 HorizontalAlignment="Right"
                                 TrackBrush="{DynamicResource TrackBrush}"
                                 ThumbBrush="{DynamicResource Text3Brush}" />
              </Panel>
            </DockPanel>

            <!-- Radio: lista stacji w miejscu kolejki (ten sam klawisz L i ta sama nakładka w wąskim oknie). -->
            <Panel x:Name="RadioHost" IsVisible="{Binding IsRadioMode}">
            <DockPanel x:Name="RadioContent" Margin="18,16,14,12"
                       DataContext="{Binding Radio}" x:DataType="vm:RadioViewModel">

              <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="6,0,6,10"
                    MinHeight="{StaticResource PanelHeaderRowHeight}">
                <TextBlock Grid.Column="0" Text="{l:Translate RadioHeading}" FontSize="13.5" FontWeight="Bold"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="tabular faint queue-summary" Text="{Binding Summary}"
                           FontSize="10" VerticalAlignment="Center" Margin="10,3,6,0" TextTrimming="CharacterEllipsis" />
                <Button x:Name="RadioAddButton" Grid.Column="2" Classes="icon" Width="26" Height="26"
                        Click="OnRadioAddToggle" ToolTip.Tip="{l:Translate TooltipRadioAdd}"
                        AutomationProperties.Name="{l:Translate TooltipRadioAdd}">
                  <Viewbox Width="13" Height="13">
                    <Path Classes="stroke" Data="{StaticResource IconPlusStroke}" Width="16" Height="16" StrokeThickness="1.4" />
                  </Viewbox>
                </Button>
                <Button x:Name="RadioImportButton" Grid.Column="3" Classes="icon" Width="26" Height="26"
                        Click="OnRadioImport" ToolTip.Tip="{l:Translate TooltipRadioImport}"
                        AutomationProperties.Name="{l:Translate TooltipRadioImport}">
                  <Viewbox Width="14" Height="14">
                    <Path Classes="stroke" Data="{StaticResource IconFolderStroke}" Width="16" Height="16" />
                  </Viewbox>
                </Button>
                <Button x:Name="RadioExportButton" Grid.Column="4" Classes="icon" Width="26" Height="26"
                        Click="OnRadioExport" ToolTip.Tip="{l:Translate TooltipRadioExport}"
                        AutomationProperties.Name="{l:Translate TooltipRadioExport}">
                  <Viewbox Width="13" Height="13">
                    <Path Classes="fill" Data="{StaticResource IconSave}" Width="16" Height="16" />
                  </Viewbox>
                </Button>
              </Grid>

              <!-- Jednorazowy baner o połączeniach radia; do jego zamknięcia nie pobiera się logo. -->
              <Border x:Name="RadioPrivacyBanner" DockPanel.Dock="Top" IsVisible="{Binding ShowsPrivacyBanner}"
                      Margin="0,0,0,10" Padding="12,10" CornerRadius="9"
                      Background="{DynamicResource Glass2Brush}"
                      BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                  <TextBlock x:Name="RadioPrivacyText" Text="{l:Translate RadioPrivacyBanner}"
                             FontSize="11.5" LineHeight="17" TextWrapping="Wrap"
                             Foreground="{DynamicResource Text2Brush}" />
                  <Button x:Name="RadioPrivacyDismiss" Classes="pill" HorizontalAlignment="Left"
                          Click="OnRadioPrivacyDismiss" Content="{l:Translate RadioPrivacyDismiss}" />
                </StackPanel>
              </Border>

              <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                <c:SegmentBar Group="{Binding ViewGroup}" />

                <TextBox x:Name="RadioSearch" Text="{Binding SearchText, Mode=TwoWay}"
                         PlaceholderText="{l:Translate RadioSearchPlaceholder}"
                         AutomationProperties.Name="{l:Translate RadioSearchPlaceholder}"
                         MinHeight="32" CornerRadius="9" FontSize="12.5"
                         Background="{DynamicResource Glass2Brush}"
                         BorderBrush="{DynamicResource StrokeBrush}" />

                <StackPanel Spacing="6" IsVisible="{Binding ShowsFilters}">
                  <ComboBox x:Name="RadioCountryBox" ItemsSource="{Binding Countries}"
                            SelectedItem="{Binding SelectedCountry, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" MinHeight="32" CornerRadius="9" FontSize="12.5"
                            AutomationProperties.Name="{l:Translate RadioCountryLabel}" />
                  <ComboBox x:Name="RadioCategoryBox" ItemsSource="{Binding Categories}"
                            SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" MinHeight="32" CornerRadius="9" FontSize="12.5"
                            AutomationProperties.Name="{l:Translate RadioCategoryLabel}" />
                </StackPanel>

                <!-- Własny adres strumienia: nazwa i adres, „Dodaj” zapisuje do ulubionych i gra. -->
                <StackPanel x:Name="RadioAddForm" Spacing="6" IsVisible="{Binding IsAdding}">
                  <TextBox x:Name="RadioAddName" PlaceholderText="{l:Translate RadioStationName}"
                           AutomationProperties.Name="{l:Translate RadioStationName}"
                           MinHeight="32" CornerRadius="9" FontSize="12.5"
                           Background="{DynamicResource Glass2Brush}" BorderBrush="{DynamicResource StrokeBrush}" />
                  <TextBox x:Name="RadioAddUrl" PlaceholderText="{l:Translate RadioStationUrl}"
                           AutomationProperties.Name="{l:Translate RadioStationUrl}"
                           MinHeight="32" CornerRadius="9" FontSize="12.5"
                           Background="{DynamicResource Glass2Brush}" BorderBrush="{DynamicResource StrokeBrush}" />
                  <Button Classes="pill primary" HorizontalAlignment="Left" Click="OnRadioAddConfirm"
                          Content="{l:Translate RadioAdd}" />
                </StackPanel>
              </StackPanel>

              <Panel>
                <ListBox x:Name="RadioList" Classes="queue"
                         ItemsSource="{Binding Rows}"
                         SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                         AutomationProperties.Name="{l:Translate RadioHeading}">
                  <ListBox.ContextMenu>
                    <ContextMenu x:Name="RadioMenu">
                      <MenuItem x:Name="RadioPlayItem" Click="OnRadioMenuPlay" />
                      <MenuItem x:Name="RadioFavouriteItem" Click="OnRadioMenuFavourite" />
                      <MenuItem x:Name="RadioWebsiteItem" Click="OnRadioMenuWebsite" />
                      <MenuItem x:Name="RadioMoveUpItem" Click="OnRadioMenuMoveUp" />
                      <MenuItem x:Name="RadioMoveDownItem" Click="OnRadioMenuMoveDown" />
                    </ContextMenu>
                  </ListBox.ContextMenu>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:StationRowViewModel">
                      <Grid ColumnDefinitions="32,*,Auto" Margin="10,7" ColumnSpacing="11" AttachedToVisualTree="OnRadioRowAttached"
                            Background="Transparent"
                            Classes.current="{Binding IsCurrent}"
                            AutomationProperties.Name="{Binding AccessibleName}">
                        <!-- Miejsce na logo o stałej wielkości; do czasu pobierania logo znak zastępczy. -->
                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" ClipToBounds="True"
                                Background="{DynamicResource Glass2Brush}"
                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                          <Panel>
                            <Image Source="{Binding Logo}" IsVisible="{Binding HasLogo}" Stretch="Uniform" Margin="2"
                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                            <Viewbox Width="15" Height="15" IsVisible="{Binding ShowsPlaceholder}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                              <Path Classes="stroke" Data="{StaticResource IconRadioStroke}" Width="16" Height="16"
                                    StrokeThickness="1.2" Stroke="{DynamicResource Text3Brush}" />
                            </Viewbox>
                          </Panel>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Classes="row-title" Text="{Binding Name}"
                                     FontSize="12.5" LineHeight="17" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="faint" Text="{Binding Detail}" FontSize="10.5"
                                     LineHeight="15" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}"
                                   IsVisible="{Binding IsCurrent}" />
                          <Button Classes="icon" Width="26" Height="26" Click="OnRadioHeart"
                                  Opacity="{Binding HeartOpacity}"
                                  ToolTip.Tip="{Binding FavouriteTooltip}"
                                  AutomationProperties.Name="{Binding FavouriteTooltip}">
                            <Panel>
                              <Viewbox Width="14" Height="14" IsVisible="{Binding !IsFavourite}">
                                <Path Classes="stroke" Data="{StaticResource IconHeart}" Width="16" Height="16" StrokeThickness="1.3" />
                              </Viewbox>
                              <Viewbox Width="14" Height="14" IsVisible="{Binding IsFavourite}">
                                <Path Classes="fill" Data="{StaticResource IconHeart}" Width="16" Height="16"
                                      Fill="{DynamicResource AccentBrush}" />
                              </Viewbox>
                            </Panel>
                          </Button>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Classes="faint" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}"
                           FontSize="11.5" TextWrapping="Wrap" Margin="8,12" VerticalAlignment="Top" />
              </Panel>
            </DockPanel>
            </Panel>
           </Panel>
           </DockPanel>

            <!--
              Krawędź do zmiany szerokości: przeciąganie zmienia szerokość, dwuklik przywraca domyślną.
              Linia 1 px rysuje obramowanie kolumny; nad krawędzią pojawia się linia w barwie akcentu.
            -->
            <Border x:Name="QueueResizeGrip" Classes="queue-grip" Width="6" HorizontalAlignment="Left"
                    Background="Transparent"
                    ToolTip.Tip="{l:Translate TooltipQueueResize}">
              <Border Classes="grip-line" Width="2" HorizontalAlignment="Left" />
            </Border>
           </Panel>
          </Border>

        </Grid>

      </DockPanel>

      <!-- ============ Scena pełnoekranowa: na wierzchu, okno pod nią ukryte ============ -->
      <v:SceneView x:Name="Scene" />
    </Panel>
  </Border>

</Window>
