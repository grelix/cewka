<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Cewka.App.Tests</RootNamespace>
    <!-- Sygnał D-Bus wysyłany w teście blokady wygaszania przez libdbus. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- Modele widoku sięgają po dyspozytor i zasoby aplikacji; testy stawiają je bez okna. -->
    <PackageReference Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cewka.App\Cewka.App.csproj" />
  </ItemGroup>

  <!--
    Pomiar trafień paska tytułu na prawdziwym oknie Windows idzie w osobnym procesie. Odwołanie
    tylko porządkuje budowę; test uruchamia program spod ścieżki zapisanej w metadanych zestawu.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Cewka.WindowProbe\Cewka.WindowProbe.csproj" ReferenceOutputAssembly="false" />
    <AssemblyMetadata Include="WindowProbePath"
                      Value="$(MSBuildThisFileDirectory)..\Cewka.WindowProbe\bin\$(Configuration)\$(TargetFramework)\Cewka.WindowProbe.dll" />
  </ItemGroup>

  <!-- Atrapy wyjścia dźwięku i dekodera wspólne z testami silnika. -->
  <ItemGroup>
    <Compile Include="..\Cewka.Audio.Tests\Engine\TestOutput.cs" Link="Engine\TestOutput.cs" />
    <Compile Include="..\Cewka.Audio.Tests\Engine\SyntheticDecoder.cs" Link="Engine\SyntheticDecoder.cs" />
    <Compile Include="..\Cewka.Audio.Tests\Engine\LiveFakes.cs" Link="Engine\LiveFakes.cs" />
    <Compile Include="..\Cewka.Audio.Tests\Live\FakeByteSource.cs" Link="Live\FakeByteSource.cs" />
  </ItemGroup>

  <!--
    Pliki językowe kopiowane obok testów. W programie są zasobem Avalonii, dostępnym dopiero
    po zainicjowaniu środowiska graficznego; test ma sprawdzać ich zawartość, a nie stawiać
    w tym celu całego środowiska.
  -->
  <ItemGroup>
    <Content Include="..\..\src\Cewka.App\Localisation\Languages\*.json"
             Link="Languages\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Lista stacji w programie i logika generatora listy: testy sprawdzają plik, który trafia do wydania. -->
  <ItemGroup>
    <Content Include="..\..\src\Cewka.App\Radio\stations.json"
             Link="Radio\stations.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\..\tools\Cewka.RadioCatalog\CatalogBuilder.cs" Link="Radio\CatalogBuilder.cs" />
  </ItemGroup>

  <!--
    Fonty interfejsu kopiowane obok testów. Sprawdzenie, czy tekst w danym języku da się wyświetlić,
    wymaga tablic znaków tych samych plików, które trafiają do wydania — nie listy zakresów
    dopisanej z pamięci.
  -->
  <ItemGroup>
    <Content Include="..\..\src\Cewka.App\Assets\Fonts\*-Regular.*"
             Link="Fonts\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
