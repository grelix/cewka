<Project>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Cewka</Product>
    <Company>Maciej Grela</Company>
    <Copyright>Copyright (c) 2026 Maciej Grela</Copyright>
    <!-- Widoczne we wlasciwosciach pliku wykonywalnego i w menedzerze zadan. -->
    <AssemblyTitle>Cewka</AssemblyTitle>
    <Description>Odtwarzacz plików muzycznych z korektorem i wyrównaniem głośności</Description>
    <!--
      Jedyne miejsce z numerem wersji. AssemblyVersion i FileVersion wyprowadza z niego SDK,
      a pkgver w packaging/arch/PKGBUILD pilnuje tools/sprawdz-wersje.sh.
    -->
    <Version>0.9.0</Version>
  </PropertyGroup>

  <!--
    Adres repozytorium trafia do metadanych zestawu, a nie do stalej w kodzie: okno ustawien,
    skrypt pakujacy i PKGBUILD maja czytac jedna wartosc. Sprawdzanie nowszej wersji buduje
    z niej adres uslugi GitHuba, wiec przeniesienie repozytorium gdzie indziej wymaga zmiany
    w jednym miejscu.
  -->
  <ItemGroup>
    <AssemblyMetadata Include="RepositoryUrl" Value="https://github.com/grelix/cewka" />
  </ItemGroup>

  <!-- Wersje pakietow trzymane centralnie, zeby projekty nie rozjechaly sie miedzy soba. -->
  <PropertyGroup>
    <AvaloniaVersion>12.1.1</AvaloniaVersion>
  </PropertyGroup>

</Project>
